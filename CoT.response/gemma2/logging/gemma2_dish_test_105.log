data = {
    'name': [
        '| --BOILED-FRESH-BRISKET-OF-BEEF,-HORSERADISH-SAUCE,-BOUILLON-POTATOES-- | 0.0            |',
        '| egg,-tetrazini                                                                                                                                                                                      | 0.3            |' ,
