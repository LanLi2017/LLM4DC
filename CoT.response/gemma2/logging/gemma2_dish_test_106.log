```python
import pandas as pd

# Assuming your data is in a CSV file named 'menu_data.csv'
df = pd.read_csv('menu_data.csv', sep='|')

# Group by dish name and calculate price differences
price_differences = df.groupby('Dish Name')['Price'].agg(lambda x: max(x) - min(x))

# Find the dish with the minimum price difference
min_difference_dish = price_differences.idxmin()
print(f"Dish with the lowest price difference: {min_difference_dish}") 
```

