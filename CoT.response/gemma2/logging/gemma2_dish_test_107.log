```python
import pandas as pd

# Assuming your data is in a CSV file named 'menu_data.csv'
df = pd.read_csv('menu_data.csv')

# Calculate price difference if 'lowest_price' column exists
if 'lowest_price' in df.columns:
    df['highest_price'] = df['highest_price'] - df['lowest_price']

# Handle missing values (example using mean imputation)
df['highest_price'].fillna(df['highest_price'].mean(), inplace=True) 
```
