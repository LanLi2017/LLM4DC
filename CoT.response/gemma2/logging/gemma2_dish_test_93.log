# Find the maximum duration
max_duration = df['duration'].max()

# Get the dishes with the maximum duration
longest_lasting_dishes = df[df['duration'] == max_duration]

print(longest_lasting_dishes[['dish_name', 'first_appeared', 'last_appeared', 'duration']]) 
```

