import re

def clean_dish_name(value):
  value = value.replace("_", " ").replace("-", " ")
  value = re.sub(r'\([^)]*\)', '', value) # Remove text within parentheses
  value = ' '.join(value.split()) # Remove extra spaces
  return value.strip().title()

return clean_dish_name(value)
return value
