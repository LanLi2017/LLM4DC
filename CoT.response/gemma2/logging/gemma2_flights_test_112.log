def standardize_datetime(date_str):
    """Attempts to parse the date string into a datetime object."""
    try:
        return pd.to_datetime(date_str, format='%Y-%m-%dT%H:%M:%SZ') 
    except ValueError:
        try:
            return pd.to_datetime(date_str, format='%Y-%m-%d %H:%M:%S')  # For 'YYYY-MM-DD HH:MM:SS'
