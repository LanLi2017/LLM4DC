```python
import pandas as pd

# Assuming your data is in a DataFrame called 'flights'

flights['delay'] = (pd.to_datetime(flights['act_dep_time']) - 
                     pd.to_datetime(flights['sched_dep_time'])).dt.total_seconds() / 60 # Delay in minutes

