df['Start_Time'] = pd.to_datetime(df['Start_Time'])
df['End_Time'] = pd.to_datetime(df['End_Time'])

# Define on-time arrival logic
def is_on_time(row):
    return (row['End_Time'] - row['Start_Time']).total_seconds() <= 900 # 15 minutes in seconds

df['On_Time'] = df.apply(is_on_time, axis=1)

# Group by airline and count on-time arrivals
