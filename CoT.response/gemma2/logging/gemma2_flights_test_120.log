    ]
}
df = pd.DataFrame(data)

# Convert to datetime objects
df['dep_time'] = pd.to_datetime(df['dep_time'])
df['act_arr_time'] = pd.to_datetime(df['act_arr_time'])

# Calculate duration and flag unrealistic flights
df['duration'] = df['act_arr_time'] - df['dep_time']
df['unrealistic'] = df['duration'].dt.total_seconds() < 0

print(df)
```

