from datetime import datetime

# Load your data into a Pandas DataFrame (assuming it's in a CSV file)
df = pd.read_csv("your_flight_data.csv") 

# Define a function to standardize time formats and check for delays
def is_delayed(scheduled_time, actual_time, delay_threshold):
  # Convert scheduled and actual times to datetime objects
  scheduled_dt = datetime.strptime(scheduled_time, '%Y-%m-%dT%H:%M:%SZ') 
  actual_dt = datetime.strptime(actual_time, '%Y-%m-%dT%H:%M:%SZ') # Adjust format if needed

  # Calculate the delay in minutes
  delay = (actual_dt - scheduled_dt).total_seconds() / 60

  return delay > delay_threshold

# Apply the function to create a 'delayed' column
df['delayed'] = df.apply(lambda row: is_delayed(row['scheduled_time'], row['actual_time'], 15), axis=1) # Change 15 for your desired delay threshold

# Extract airline codes
df['airline'] = df['flight'].str.split('-').str[0]

# Count delays per airline
delay_counts = df.groupby('airline')['delayed'].sum()

print(delay_counts)
```

