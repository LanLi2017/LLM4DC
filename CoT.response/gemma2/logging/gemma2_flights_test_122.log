import pandas as pd

# Assuming your data is in a CSV file named 'flight_data.csv'
df = pd.read_csv('flight_data.csv', sep='|') 

# Convert the date and time columns to datetime objects
df['sched_dep_time'] = pd.to_datetime(df['sched_dep_time'])
df['sched_arr_time'] = pd.to_datetime(df['sched_arr_time'])

# Calculate flight duration in minutes
