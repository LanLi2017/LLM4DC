import pandas as pd

# Assuming you have a DataFrame called 'flights'

# Load additional data (replace with your actual method)
additional_data = pd.read_csv('flight_records.csv') 

# Merge the DataFrames based on a common column (e.g., 'flight_id')
flights = pd.merge(flights, additional_data, on='flight_id', how='left')

# Convert sched_dep_time and actual_dep_time to datetime objects
flights['sched_dep_time'] = pd.to_datetime(flights['sched_dep_time'])
flights['actual_dep_time'] = pd.to_datetime(flights['actual_dep_time'])

# Calculate delay in minutes
flights['delay_minutes'] = (flights['actual_dep_time'] - flights['sched_dep_time']).dt.total_seconds() / 60

# Define delay status
flights['delay_status'] = pd.cut(flights['delay_minutes'], bins=[-float('inf'), 15, float('inf')], labels=['On Time', 'Delayed'])
```

