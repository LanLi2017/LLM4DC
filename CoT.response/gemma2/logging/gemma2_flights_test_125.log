merged_df = pd.merge(df, flight_tracking_data, on='flight_number')

# Convert time strings to datetime objects for calculation
merged_df['sched_dep_time'] = pd.to_datetime(merged_df['sched_dep_time'])
merged_df['actual_departure_time'] = pd.to_datetime(merged_df['actual_departure_time'])

# Calculate delay in minutes
merged_df['delay_minutes'] = (merged_df['actual_departure_time'] - merged_df['sched_dep_time']).dt.total_seconds() / 60

# Categorize delays
def categorize_delay(delay):
    if delay <= 15:
        return "On Time"
    elif delay > 15 and delay <= 60:
        return "Delayed"
    else:
        return "Significantly Delayed"

merged_df['delay_status'] = merged_df['delay_minutes'].apply(categorize_delay)

# Now you have a enriched dataset ready for analysis!
```
