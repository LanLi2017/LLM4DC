import pandas as pd
import re

# Assuming your data is in a CSV file named 'menus.csv'
df = pd.read_csv('menus.csv', sep='|') 

def extract_year(date_string):
    match = re.search(r'\d{4}', date_string)  # Matches 4 consecutive digits (the year)
    if match:
        return int(match.group())
    else:
        return None # Handle cases where the year is missing

df['year'] = df['date'].apply(extract_year)
