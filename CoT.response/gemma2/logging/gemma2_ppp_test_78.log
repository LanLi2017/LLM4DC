 python
import re

def clean_dish_name(value):
  value = value.lower() # Convert to lowercase
  value = re.sub(r'[\[\]\-\_\;\:\"\']', '_', value) # Replace special characters with underscores
  return value.strip('_') # Remove leading/trailing underscores

return clean_dish_name(value)
return value
