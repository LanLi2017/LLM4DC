[
    {
        "op": "core/mass-edit",
        "engineConfig": {
            "facets": [],
            "mode": "row-based"
        },
        "columnName": "Results",
        "expression": "value",
        "edits": [
            {
                "from": [
                    "pas",
                    "passs",
                    "p@ss"
                ],
                "fromBlank": false,
                "fromError": false,
                "to": "Pass"
            },
            {
                "from": [
                    "out of business",
                    "Not_Ready",
                    "faild",
                    "Pass w/ Conditions",
                    "no entry"
                ],
                "fromBlank": false,
                "fromError": false,
                "to": "Fail"
            }
        ],
        "description": "Mass edit cells in column Results"
    },
    {
        "op": "core/text-transform",
        "engineConfig": {
            "facets": [],
            "mode": "row-based"
        },
        "columnName": "License #",
        "expression": "value.toNumber()",
        "onError": "set-to-blank",
        "repeat": false,
        "repeatCount": 10,
        "description": "Text transform on cells in column License # using expression value.toNumber()"
    }
]