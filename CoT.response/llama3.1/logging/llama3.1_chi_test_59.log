INFO:root:#TASK III: generate regexr arguments: 

 jython:import re
from collections import Counter

def process_facility_type(value):

    value = re.sub(r'\s{2,}', ' ', value).lower()

    standardized_types = {
        'liquor': ['liquor', 'alcohol'],
        'grocery store': ['grocery store', 'supermarket'],
        'restaurant': ['restaurant', 'eatery', 'cafe'],
        'school': ['school', 'educational institution'],
        'mobile food dispenser': ['mobile food dispenser', 'food truck']
    }

    for key, values in standardized_types.items():
        if any(value == v or value.startswith(v + ',') for v in values):
            return key

    return value

facility_types = [
    'Liquor',
    'Grocery Store',
    'Restaurant',
    'School',
    'Restaurant',
    'Restaurant',
    'Mobile Food Dispenser',
    'Restaurant',
    'Wholesale',
    'Mobile Food Dispenser'
]

standardized_types = [process_facility_type(t) for t in facility_types]
print(Counter(standardized_types))
