```python
import pandas as pd

# Assuming df is your DataFrame
df = pd.read_csv('your_data.csv')

# Define a function to convert time formats into a consistent format (in this case, datetime)
def convert_time(x):
    if isinstance(x, str):  # Check if x is a string
        try:
            return pd.to_datetime(x, format='%Y-%m-%dT%H:%M:%SZ')  # Try to parse as ISO format
        except ValueError:  # If not ISO format, try other formats
            for fmt in ['%m/%d/%Y %I:%M:%S %p', '%m/%d/%Y %H:%M:%S', '%m/%d/%Y %H:%M',
                        '%Y-%m-%dT%H:%M:%S', '%Y-%m-%d %H:%M:%S', '%Y-%m-%d %I:%M:%S %p']:
                try:
                    return pd.to_datetime(x, format=fmt)
                except ValueError:
                    pass  # If none of the formats match, return NaN
            return None  # Return None if all else fails
    elif isinstance(x, pd.Timestamp):  # If x is already a pandas Timestamp object
        return x

# Apply the conversion function to the sched_arr_time column
df['sched_arr_time'] = df['sched_arr_time'].apply(convert_time)

# Ensure the converted times are in datetime format (not necessary if they're already)
df['sched_arr_time'] = pd.to_datetime(df['sched_arr_time'])

# Group by airline carrier and count on-time arrivals
on_time_count = df[df['sched_arr_time'] <= df['actual_arr_time']].groupby('airline')['sched_arr_time'].count().reset_index()

print(on_time_count)
```

