import pandas as pd

# Assuming 'df' is your DataFrame and 'sched_dep_time' is the column containing departure times.
def clean_and_parse_time(time_str):
    # Try to parse time in various formats
    for fmt in ["%Y-%m-%dT%H:%M:%SZ", "%Y-%m-%d %H:%M:%S", 
                "%Y-%m-%d %I:%M:%S %p", "%Y/%m/%d %H:%M:%S", 
                "%Y-%m-%d %H:%M:%S.%f", "%Y-%m-%dT%H:%M:%S.%fZ",
                "%m/%d/%Y %H:%M:%S", "%m/%d/%Y %I:%M:%S %p"]:
        try:
            return pd.to_datetime(time_str, format=fmt)
        except ValueError:
            pass
    # If all formats fail, return NaT (Not a Time) to indicate failure in parsing.
    return pd.NaT

# Apply the function to your 'sched_dep_time' column
df['clean_dep_time'] = df['sched_dep_time'].apply(clean_and_parse_time)

# Ensure that both departure and arrival times are in the same format for consistency
def clean_and_parse_arrival_time(time_str):
    return pd.to_datetime(time_str, format="%Y-%m-%dT%H:%M:%SZ")  # Assuming this is a common format

