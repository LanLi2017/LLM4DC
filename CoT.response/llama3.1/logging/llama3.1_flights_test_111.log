```python
import pandas as pd

# Load the data into a DataFrame
df = pd.read_csv('your_data.csv')

# Define a function to standardize the sched_dep_time column
def standardize_sched_dep_time(x):
    if isinstance(x, str) and x.startswith('1900-'):
