df['sched_dep_time'] = df['sched_dep_time'].apply(convert_to_datetime)

# Filter out rows where either arrival or departure time is missing
df_filtered = df.dropna(subset=['sched_arr_time', 'sched_dep_time'])

# Calculate the flight duration in minutes
df_filtered['flight_duration_minutes'] = (df_filtered['sched_dep_time'] - 
                                          df_filtered['sched_arr_time']).dt.total_seconds() / 60

# Calculate the average flight duration
average_flight_duration = df_filtered['flight_duration_minutes'].mean()

print(f'The average flight duration is {average_flight_duration} minutes.')
```

