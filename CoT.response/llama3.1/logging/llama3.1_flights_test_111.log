```python
import pandas as pd

# Assuming df is your DataFrame
df = pd.DataFrame({
    'sched_dep_time': ['1900-03-31T23:50:00Z', '1900-03-31T14:00:00Z', '1900-03-31T15:50:00Z'],
    'actual_dep_time': ['03/31/1900 23:50:00', '1900-03-31t14:10:00z', '1900-03-31t16:09:00z'],
    'sched_arr_time': ['1900-03-31T20:25:00Z', '1900-03-31T11:45:00Z', '1900-03-31T11:50:00Z']
})

# Convert sched_dep_time and sched_arr_time to datetime objects
df['sched_dep_time'] = pd.to_datetime(df['sched_dep_time'])
df['sched_arr_time'] = pd.to_datetime(df['sched_arr_time'])

# Calculate the duration between departure and arrival times
df['duration'] = df['sched_arr_time'] - df['sched_dep_time']

# Identify flights with unrealistic durations (arrival time before departure time)
unrealistic_durations = df[df['duration'] < pd.Timedelta(0)]

print(unrealistic_durations)
```

