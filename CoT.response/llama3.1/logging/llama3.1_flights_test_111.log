```python
import pandas as pd
from datetime import datetime

# Assuming your data is in a DataFrame called 'df'
def convert_to_datetime(time_str):
    # Try to parse time string into datetime object
    try:
        return pd.to_datetime(time_str, format='ISO8601')
    except ValueError:
        # If ISO8601 fails, try other formats
        for fmt in ['%m-%d-%Y %H:%M', '%m/%d/%Y %H:%M:%S', '%m/%d/%Y %I:%M %p',
                    '%d-%m-%Y %H:%M', '%d-%m-%Y %I:%M %p']:
            try:
                return pd.to_datetime(time_str, format=fmt)
            except ValueError:
                pass
        # If all formats fail, return None
        return None

# Apply the conversion function to both columns
