```python
import pandas as pd

# Assuming df is your DataFrame with the flight data
df = pd.read_csv('your_data.csv')

# Function to convert time strings into datetime objects
def convert_time(time_str):
    if isinstance(time_str, str):  # Check if it's a string
        if '-' in time_str:  # Assuming date format is YYYY-MM-DD HH:MM:SS or YYYY-MM-DD HH:MM
            return pd.to_datetime(time_str, format='%Y-%m-%d %H:%M')
        elif '/' in time_str:  # Assuming date format is MM/DD/YYYY HH:MM:SS or MM/DD/YYYY HH:MM
            return pd.to_datetime(time_str, format='%m/%d/%Y %H:%M:%S' if ':' in time_str else '%m/%d/%Y %H:%M')
        elif 'T' in time_str:  # Assuming date format is YYYY-MM-DDTHH:MM:SSZ or YYYY-MM-DD HH:MM
            return pd.to_datetime(time_str, format='%Y-%m-%dT%H:%M:%SZ' if ':' in time_str else '%Y-%m-%d %H:%M')
        elif 'AM' in time_str or 'PM' in time_str:  # Assuming date format is MM/DD/YYYY HH:MM AM/PM
            return pd.to_datetime(time_str, format='%m/%d/%Y %I:%M %p')
    else:
        return None

# Apply the conversion function to the sched_arr_time column
df['sched_arr_time'] = df['sched_arr_time'].apply(convert_time)

# Ensure all values are datetime objects
df['sched_arr_time'] = pd.to_datetime(df['sched_arr_time'])

# Group by airline carrier and count on-time arrivals (assuming arrival time is within 15 minutes of scheduled time)
