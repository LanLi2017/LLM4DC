INFO:root:#TASK III: generate regexr arguments: 

 jython:import re
from collections import Counter

def process_src(value):
    value = re.sub(r'[_-]', '', value)
    return value

values = [
    "PANYNJ",
    "Business Travel Logue",
    "--flightaware--",
    "MyTripAndMore",
    "FlyLouisville",
    "Fly Louisville",
    "flightview",
    "FlightExplorer",
    "Fly Louisville",
    "flightarrival",
    "Flightwise",
    "Flightwise",
    "Business Travel Logue",
    "Fox Business",
    "USA Today",
    "__world-flight-tracker__",
    "Fly Louisville",
    "Flightwise",
    "Quick Trip"
]

cleaned_values = [process_src(value) for value in values]
counts = Counter(cleaned_values)

result = ' | '.join(f'{key}: {value}' for key, value in counts.items())
print(result)
