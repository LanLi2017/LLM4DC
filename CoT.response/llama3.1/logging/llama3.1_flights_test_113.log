def convert_to_seconds(time_str):
    if '-' in time_str:
        date, time = time_str.split(' ')
        year, month, day = map(int, date.split('-'))
        hour, minute, second = map(int, time.split(':'))
    elif 'T' in time_str:
        date_time = pd.to_datetime(time_str)
        return (date_time - pd.Timestamp('1970-01-01')).total_seconds()
    else:  # Handle other formats if needed
        raise ValueError("Unsupported format")
    
    return year * 31536000 + month * 2628000 + day * 86400 + hour * 3600 + minute * 60 + second

