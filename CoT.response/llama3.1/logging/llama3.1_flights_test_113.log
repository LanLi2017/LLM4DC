```python
import pandas as pd

# Load the data into a DataFrame
df = pd.read_csv('your_data.csv')

# Convert the 'act_dep_time' column to datetime objects in ISO 8601 format
df['act_dep_time'] = pd.to_datetime(df['act_dep_time'], format='iso', errors='coerce')

