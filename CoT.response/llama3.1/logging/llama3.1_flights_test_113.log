# Step 2: Convert Actual Departure Time to Seconds Since Midnight
def convert_actual_departure(time_str):
    if 'T' in time_str:
        date_time = pd.to_datetime(time_str)
        return (date_time - pd.Timestamp('1970-01-01')).total_seconds()
    else:  
        raise ValueError("Unsupported format")
    
# Apply the function to the actual_dep_time column
