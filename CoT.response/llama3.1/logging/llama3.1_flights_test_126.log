df = pd.DataFrame(data)

# Convert the time columns to datetime objects
def convert_time(time_str):
    if "-" in time_str:
        return None
    else:
        components = time_str.split("-")
        hour, minute = map(int, components[0].split(":"))
        am_pm = components[1]
        if am_pm == "p.m." and hour != 12:
            hour += 12
        elif am_pm == "a.m." and hour == 12:
            hour = 0
        return pd.to_datetime(f"{hour}:{minute}:00", format="%I:%M:%S")

df["sched_dep_time"] = df["sched_dep_time"].apply(convert_time)
df["actual_dep_time"] = df["actual_dep_time"].apply(convert_time)
df["sched_arr_time"] = df["sched_arr_time"].apply(convert_time)
df["actual_arr_time"] = df["actual_arr_time"].apply(convert_time)

# Calculate the discrepancy between scheduled and actual arrival times
df["discrepancy"] = (df["actual_arr_time"] - df["sched_arr_time"]).dt.total_seconds() / 3600

# Sort the flights by their discrepancies in descending order
df_sorted = df.sort_values(by="discrepancy", ascending=False)

# Print out the top 5 flights with the largest discrepancies
print(df_sorted.head(5)[["flight_number", "sched_arr_time", "actual_arr_time", "discrepancy"]])
