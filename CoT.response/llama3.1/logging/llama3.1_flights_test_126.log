```python
import pandas as pd

data = """
row 13: | --9:54-a.m.--    | UA-3925-IAD-ORF   | 9:43-a.m.        |
...
"""

rows = [line.strip() for line in data.split('\n')]

flight_data = []

for row in rows:
    if 'row' not in row:
        parts = row.split('|')
        flight_number = parts[1].strip()
        sched_arr_time = parts[2].replace('-', '').replace('a.m.', '').replace('p.m.', '')
        actual_arr_time = parts[3].replace('-', '').replace('a.m.', '').replace('p.m.', '')
        
        flight_data.append({
            'flight_number': flight_number,
            'sched_arr_time': sched_arr_time,
            'actual_arr_time': actual_arr_time
        })

df = pd.DataFrame(flight_data)

df['sched_arr_time'] = pd.to_datetime(df['sched_arr_time'], format='%H:%M')
df['sched_hour'] = df['sched_arr_time'].dt.hour
df['sched_minute'] = df['sched_arr_time'].dt.minute

df.drop(columns=['sched_arr_time'], inplace=True)

df['actual_arr_time'] = pd.to_datetime(df['actual_arr_time'], format='%H:%M')
df['actual_hour'] = df['actual_arr_time'].dt.hour
df['actual_minute'] = df['actual_arr_time'].dt.minute

df.drop(columns=['actual_arr_time'], inplace=True)

df['diff_hours'] = (df['sched_hour'] - df['actual_hour']).abs()
df['diff_minutes'] = (df['sched_minute'] - df['actual_minute']).abs()

df['diff_minutes'] = df['diff_minutes'].apply(lambda x: x / 60)
df['total_diff_hours'] = df['diff_hours'] + df['diff_minutes']

df_sorted = df.sort_values(by='total_diff_hours', ascending=False)

top_5_flights = df_sorted.head(5)

print(top_5_flights)
```

This code will output the top 5 flights with the largest difference between scheduled and actual arrival times.
