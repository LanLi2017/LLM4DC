        "expression": "jython:import re\nfrom collections import Counter\n\ndef process_facility_type(value):\n\n    value = re.sub(r'\\s{2,}', ' ', value).lower()\n\n    standardized_types = {\n        'liquor': ['liquor', 'alcohol'],\n        'grocery store': ['grocery store', 'supermarket'],\n        'restaurant': ['restaurant', 'eatery', 'cafe'],\n        'school': ['school', 'educational institution'],\n        'mobile food dispenser': ['mobile food dispenser', 'food truck']\n    }\n\n    for key, values in standardized_types.items():\n        if any(value == v or value.startswith(v + ',') for v in values):\n            return key\n\n    return value\n\nfacility_types = [\n    'Liquor',\n    'Grocery Store',\n    'Restaurant',\n    'School',\n    'Restaurant',\n    'Restaurant',\n    'Mobile Food Dispenser',\n    'Restaurant',\n    'Wholesale',\n    'Mobile Food Dispenser'\n]\n\nstandardized_types = [process_facility_type(t) for t in facility_types]\nprint(Counter(standardized_types))",
