 jython:import re

def standardize_dba(value):
  # Remove numbers, spaces, and special characters from the beginning or end of the string
  value = re.sub(r'^\d+|\s+|[#\W]+\s*$', '', value)

  # Convert to lowercase and remove hyphens
  value = re.sub(r'-', ' ', value).lower()

  return value

# Apply the standardize_dba function to each row in the DBA column
cleaned_dba = df['DBA Name'].apply(standardize_dba)

# Filter for rows where the cleaned DBA name matches "7-eleven"
failed_inspections = df[(cleaned_dba == '7-eleven') & (df['Inspection Result'] != 'Passed')]

# Return the list of failed inspections for establishments with the DBA name "7-Eleven"
return failed_inspections['Establishment Name'].tolist()
return value
