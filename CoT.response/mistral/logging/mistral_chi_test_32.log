# Standardize the representation of "7-Eleven" to a consistent format
def standardize_dba(value):
    value = value.lower() # Convert to lowercase for consistency
    if re.search(r'^7\w*eleven$', value) or re.search(r'^7\-eleven$', value) or re.search(r'^7\-eleven \#', value):
        return "7-Eleven"
    elif re.search(r'\b7\-eleven\b', value):
        return "7-Eleven"
    else:
        return value

# Ensure that the table contains relevant information about inspections
def check_inspection_info(value):
    if re.search(r'failed inspection', value, re.IGNORECASE) or re.search(r'violation', value, re.IGNORECASE):
        return True
    else:
        return False

# Apply the functions to the data
