 jython:import re
def clean_inspections(data):
    cleaned = []
    for row in data:
        if '7-eleven' in row.lower():
            row = row.lower()
            row = re.sub(r'\s+', ' ', row)
            row = re.sub(r'[^a-z0-9\s]', '', row)
            if 'pas' in row:
                row = 'PASS'
            elif 'fail' in row or 'fal' in row or 'failed' in row:
                row = 'FAIL'
            cleaned.append(row)
    return cleaned

