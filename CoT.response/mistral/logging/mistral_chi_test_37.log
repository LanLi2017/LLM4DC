 jython:import re

def standardize_results(value):
    # Lowercase all characters to ensure consistent casing
    value = value.lower()

    # Remove non-alphabetic characters and spaces
    value = re.sub(r'[^a-z\s]', '', value)

    # Replace multiple spaces with a single space
    value = re.sub(r'\s+', ' ', value)

    return value

# Apply the standardization function to each cell in the Results column
results_column = df['Results']
standardized_results_column = results_column.apply(standardize_results)
return value
