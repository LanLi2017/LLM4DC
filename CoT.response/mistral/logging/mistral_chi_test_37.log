INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

 # Extract the facility identifier (if present) before the Risk value
 pattern = re.compile(r'^(\w+)\s')
 match = pattern.match(value)
 if match:
   facility_id = match.group(1)
 else:
   facility_id = ''

 # Extract the risk level and convert it to a numerical value (Low=1, Medium=2, High=3)
 pattern = re.compile(r'(\w+)\s(\d)')
 match = pattern.match(value)
 if match:
   risk_level = int(match.group(2))
 else:
   risk_level = 0

 # Return the updated value with facility identifier and numerical risk level
 return facility_id + ':' + str(risk_level)
return value
