 jython:import re

 # Define a pattern to match common facility names (e.g., restaurant, school, hotel, shop, store)
 facility_pattern = r'(restaurant|school|hotel|shop|store)'

 def is_facility(value):
     # Check if the value matches the defined pattern
     return re.search(facility_pattern, value, re.IGNORECASE) is not None

 # Apply the function to each row and return a list of facilities
 facilities = [row for row in data if is_facility(row)]

 # Now that we have a list of facilities, we can filter them based on the inspection rating (Risk 3 - Low)
 risk_3_facilities = [facility for facility in facilities if 'Risk 3' in facility]

 # Join the results into a single string with newlines between each entry
 output = '\n'.join(risk_3_facilities)

 return output
