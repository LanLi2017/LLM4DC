 jython:import re

# Remove special characters and spaces
def clean_name(name):
    return re.sub(r'[^\w\s]', '', name).strip()

# Split the cleaned name into words (ignoring case)
def split_words(name):
    return re.findall(r'\b\w+\b', clean_name(name).lower())

# Join the words back together to form a standardized name
def standardize_name(words):
    return '_'.join(words)

# Apply the cleaning and standardization functions to each franchise name in the column
def standardize_column(column):
    return [standardize_name(split_words(name)) for name in column]

