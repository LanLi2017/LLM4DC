INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

def standardize_business_type(value):
    # Remove extra spaces, punctuation, and convert to lowercase
    value = re.sub(r'\s+', ' ', value).lower()

    # Standardize the business types
    if "sole proprietorship" in value:
        return "Sole Proprietorship"
    elif "limited liability company" in value:
        return "Limited Liability Company (LLC)"
    elif "corporation" in value:
        return "Corporation"
    elif "non-profit organization" in value:
        return "Non-Profit Organization"
    elif "subchapter s corporation" in value:
        return "Subchapter S Corporation"
    elif "independent contractors" in value:
        return "Independent Contractors"
    else:
        # If the business type is not recognized, return the original value for now
        return value

# Apply the function to the table data
data = [
    "SOLE_PROPRIETORSHIP",
    "LIMITED LIABILITY COMPANY(LLC)",
    "CORPORATION",
    "NON-PROFIT ORGANIZATION",
    "CORPORATION",
    "SOLE PROPRIETORSHPI",
    "INDEPENDENT CONTRACTORS",
    "LIMITED_LIABILITY_COMPANY(LLC)",
    "SUBCHAPTER S CORPORATION",
    "SOLE PROPRIETORSHIP",
    "LIMITED LIABILITY COMPANY(LLC)",
    "INDEPENDENT CONTRACTORS",
    "SUBCHAPTER S CORPORATION",
    "LIMITED LIABILITY COPMANY(LLC)",
    "LIMITED LIABILITY COMPANY(LLC)",
    "NON-PROFIT ORGANIZATION",
    "CORPORATION",
    "SELF-EMPLOYED INDIVIDUALS",
    "SOLE PROPRIETORSHIP",
    "SOEL PROPRIETORSHIP"
]

standardized_data = [standardize_business_type(value) for value in data]
print(standardized_data)
return value
