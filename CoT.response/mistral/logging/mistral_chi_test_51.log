 jython:import re

# Assuming that you have a separate dataframe or list containing the inspection results
inspection_results = ["pass", "fail", "pass", "pass", "pass", "fail", "pass", "pass", "pass", "pass"]

def add_inspection_result(value):
    match = re.search(r'\d+', value) # Find a digit in the address to associate it with the inspection result
    if match:
        return f"{match.group(0)} {inspection_results[int(match.group(0)) - 1]}"
    else:
        return "No association found"

# Apply the function to the Address column
df['Address'] = df['Address'].apply(add_inspection_result)
return value
