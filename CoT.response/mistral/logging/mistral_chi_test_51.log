# Iterate through the sorted dataframe and calculate total delay minutes for each airline carrier
for index, row in sorted_df.iterrows():
    if row['airline_carrier'] not in total_delay:
        total_delay[row['airline_carrier']] = row['departure_time_diff']
    else:
        total_delay[row['airline_carrier']] += row['departure_time_diff']

# Find the airline carrier with the highest total delay minutes
max_delay_airline = max(total_delay, key=total_delay.get)
print(f'The airline carrier handling the most "delayed" flights is: {max_delay_airline}')
