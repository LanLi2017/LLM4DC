```python
import pandas as pd

# Assuming df is your DataFrame and it has columns 'airline_carrier', 'scheduled_departure', 'actual_departure'
df['departure_time_diff'] = (pd.to_datetime(df['actual_departure']) - pd.to_datetime(df['scheduled_departure'])).dt.total_seconds() / 60

# Sort the dataframe based on airline_carrier and departure_time_diff columns
sorted_df = df.sort_values(['airline_carrier', 'departure_time_diff'])

# Initialize a dictionary to store total delay minutes for each airline carrier
