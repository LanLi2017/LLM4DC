 jython:import re
match = re.search(r'[A-Z]+', value)
if match:
 business_type = match.group(0).lower()
else:
 business_type = value.lower()

business_type = re.sub(r'\s+', ' ', business_type)
business_type = re.sub(r'[(),\.]', '', business_type)

if business_type == 'self-employed individuals':
 business_type = 'Self-Employed Individual'
elif business_type == 'independent contractors':
 business_type = 'Independent Contractor'
elif business_type == 'limited liability company(llc)' or business_type == 'limited liability company (llc)' or business_type == 'limited liability co (llc)':
 business_type = 'Limited Liability Company (LLC)'
elif business_type == 'corporation' or business_type == 'corp':
 business_type = 'Corporation'
elif business_type == 'subchapter s corporation' or business_type == 'subchapter s corp':
 business_type = 'Subchapter S Corporation'
elif business_type == 'non-profit organization' or business_type == 'non profit organization':
 business_type = 'Non-Profit Organization'
elif business_type == 'osle proprietorship' or business_type == 'sole proprietorship':
 business_type = 'Sole Proprietorship'
elif business_type == 'independent contractors inc.':
 business_type = 'Independent Contractor Inc.'
elif business_type == 'sole proprietorship':
 business_type = 'Sole Proprietorship'
elif business_type == 'subchapter s corportaion':
 business_type = 'Subchapter S Corporation'
elif business_type == 'limited liability comp(llc)' or business_type == 'limited liability co (llc)':
 business_type = 'Limited Liability Company (LLC)'
elif business_type == 'limited liabilt ycompany(llc)' or business_type == 'limited liabilit y company (llc)':
 business_type = 'Limited Liability Company (LLC)'
elif business_type == 'non-profit organi(zation)' or business_type == 'non profit organizati(on)':
 business_type = 'Non-Profit Organization'
elif business_type == 'limited_liability_company(llc)' or business_type == 'limited liability company (LLC)' or business_type == 'limited liability co (LLC)':
 business_type = 'Limited Liability Company (LLC)'
else:
 business_type = 'Unknown Business Type'

return business_type
return value
