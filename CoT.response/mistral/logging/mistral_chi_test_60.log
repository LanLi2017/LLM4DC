import re
def standardize_business_type(value):
    value = value.strip()
    value = re.sub(r'\[|\]', '', value)
    value = re.sub(r's\.', ' S.', value)
    value = re.sub(r'S\.S', ' S.S', value)
    value = re.sub(r'\s+', ' ', value).strip()
    return value.title()

data = ["Self-Employed Individuals", "Sole Proprietorship", "Independent Contractors", "Corporation", "Sole Proprietorship", "Limited Liability Company(LLC)", "Limited Liability Company(LLC.)", "Sole Proprietorship", "[Sole Proprietorship]", "Sole Proprietorship", "Non-Profit Organization", "Corporation", "Limited  liability company(LLC)", "Subchapter S Corporation", "Independent Contractors", "S.S Corporation", "Non-Profit Organizations", "Corporation", "limited  liability company(LLC);", "Limited Liability Company(LLC)"]

standardized_data = [standardize_business_type(value) for value in data]
print(standardized_data)

