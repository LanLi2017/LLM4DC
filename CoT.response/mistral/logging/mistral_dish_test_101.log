INFO:root:#TASK III: generate regexr arguments: 

 jython:import re
def standardize_menu(data):
    cleaned_data = []
    for row in data:
        name = row[0].lower()
        if ',' in name:
            cleaned_name = re.sub(r'\s*,\s*', ',', name).strip().title()
        elif ',' not in name:
            cleaned_name = re.sub(r'\s+', ' ', name).strip().title() + ' (Category)'
        cleaned_data.append([cleaned_name])
    return cleaned_data

