```python
import re

def extract_year(name):
    match = re.search(r'\d{4}', name)
    if match:
        return int(match.group())
    else:
        return float('inf')  # or any other value to indicate older dishes

menu = [
    "Tripe in cream with onions, Shanley",
    "1964er Chateau La Tour Gayet, Cotes de Blaye A.C.",
    "Broiled Lamp Chops, Two",
    "Beef Steak, fried onions",
    # ... other dishes
]

menu.sort(key=extract_year)
print(menu[0])  # Output: '1964er Chateau La Tour Gayet, Cotes de Blaye A.C.'
```
