 python
import re

def clean_dish(value):
    # Remove underscores, dashes, and spaces
    value = re.sub(r'[_- ]+', ' ', value).strip()

    # Split the cleaned dish name into parts based on commas or hyphens
    parts = value.split(',')

    # Initialize an empty dictionary to store the dish details
    dish_details = {}

    for part in parts:
        # Remove any remaining underscores, dashes, and spaces from each part
        part = re.sub(r'[_- ]+', '', part).strip()

        if part:  # If the part is not empty
            key, value = part.split('_')  # Split the part into a key and a value using underscores as separators
            dish_details[key] = value

    return dish_details

# Apply the clean_dish function to each row in the table
