 python
import re
from collections import Counter

def standardize_dish(dish):
    # Remove special characters and spaces, convert to lowercase, and join words
    cleaned_dish = re.sub(r'[^\w\s]', '', dish).lower().split()
    # Join the words back together with underscores as separators
    standardized_dish = '_'.join(cleaned_dish)
    return standardized_dish

def count_dishes(menu):
    # Standardize all dishes in the menu and count their occurrences
    standardized_menu = [standardize_dish(dish) for dish in menu]
    dish_counts = Counter(standardized_menu)
    return dish_counts

