import pandas as pd

# Assuming df is your DataFrame
df = pd.read_csv('your_data.csv')

# Rename column
df['popularity'] = df['times_appeared']

# Create a new column for dish names
df['dish_name'] = df['row'].apply(lambda x: '__' + str(x) if x[0] == '1' else '')

# Combine rows with the same dish name, split by commas and filter out empty rows
df['dish_name'] = df.groupby('dish_name')['dish_name'].apply(lambda x: ', '.join(x) if len(x) > 1 else x).fillna('').str.split(', ')
df = df[~df['dish_name'].str.len().eq(0)]

# Sort by popularity and find the top 10 dishes
top_dishes = df.sort_values(['popularity'], ascending=False).head(10)

# Calculate the lowest price for each dish
lowest_prices = top_dishes.groupby('dish_name')['price'].min()
```
