import pandas as pd

# Assuming df is your DataFrame
df = pd.read_csv('yourfile.csv', header=None)
df.columns = ['dish_name', 'times_appeared', 'other_info']  # Rename the column

def extract_price(row):
    if row['other_info'][0] == '_':  # If it's a dish name, try to find a price
        for i in range(1, len(row['other_info'])):
            if row['other_info'][i].isdigit():
                return float(row['other_info'][i])
    return ''  # If no price is found, return an empty string

df['price'] = df.apply(extract_price, axis=1)

# Sort the dataframe based on popularity in descending order
df = df.sort_values(by='popularity', ascending=False)

# Filter the dataframe to only include the top 10 most popular dishes
top_dishes = df.nlargest(10, 'popularity')
```
