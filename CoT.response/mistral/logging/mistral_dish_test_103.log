df.rename(columns={'times_appeared': 'popularity'}, inplace=True)

# Sort by popularity in descending order and filter out dishes with less than 1 appearance
df = df.sort_values('popularity', ascending=False)[df['popularity'] >= 1]

# Create a new column 'price_lowest' that stores the lowest price for each dish
df['price_lowest'] = df.groupby('dish_name')['price'].transform('min')

# Select top 10 dishes based on popularity and display their name and lowest price
