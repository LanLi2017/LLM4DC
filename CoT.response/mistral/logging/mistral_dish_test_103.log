    prices = top_dishes[top_dishes['dish_name'] == row['dish_name']]['price'].tolist()
    if len(prices) > 0:
        return min(prices)
    else:
        return None

top_dishes['lowest_price'] = top_dishes.apply(find_lowest_price, axis=1)
