        SELECT Dish_Name, times_appeared, price FROM (
            SELECT Dish_Name, times_appeared, price, ROW_NUMBER() OVER(ORDER BY times_appeared DESC) as row_num
            FROM your_table_name
        ) AS temp WHERE row_num <= 10
    ) AS dish_prices GROUP BY Dish_Name;
