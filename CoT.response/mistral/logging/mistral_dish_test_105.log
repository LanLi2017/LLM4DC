   # Function to count the occurrences of each dish name
   def count_dish(data):
       dish_count = {}
       for dish in data:
           cleaned_dish = clean_dish(dish)
           if cleaned_dish not in dish_count:
               dish_count[cleaned_dish] = 1
           else:
               dish_count[cleaned_dish] += 1
       return dish_count

   # Count the occurrences of each dish name
   dish_occurrences = count_dish(data)

   # Find dishes that appear more than 20 times
   frequent_dishes = {k: v for k, v in dish_occurrences.items() if v > 20}

