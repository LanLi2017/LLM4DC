 jython:import datetime
import re

def standardize_time(value):
    # Convert 12-hour AM/PM format to 24-hour format
    if 'AM' in value or 'PM' in value:
        time = value.split(' ')
        hour = int(time[0].split(':')[0])
        if 'PM' in value:
            hour += 12
        standardized_time = f"{hour}:{time[0].split(':')[1]}:{time[0].split(':')[2]}"
    else:
        standardized_time = value

    # Ensure the time is in HH:MM:SS format
    match = re.search(r'(\d{2}):(\d{2}):(\d{2})', standardized_time)
    if not match:
        raise ValueError("Invalid time format")

    return standardized_time

# Apply the function to each cell in the 'sched_arr_time' column
output = [standardize_time(value) for value in column['sched_arr_time']]
return output
return value
