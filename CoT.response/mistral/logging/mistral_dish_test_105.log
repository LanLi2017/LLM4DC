# Assuming that there is a column named 'dish_name' in the dataset, which contains the name or unique identifier of each dish.
# For simplicity, let's assume that the 'dish_name' column is located before the 'highest_price' column.

def get_unique_dishes(column):
    unique_dishes = set()
    for value in column:
        match = re.search(r'\b\w+\b', value)  # Match any word (dish name or identifier)
        if match:
            unique_dishes.add(match.group(0))
    return list(unique_dishes)

