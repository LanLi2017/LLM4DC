# Assuming df is your DataFrame
df['act_dep_time'] = df['act_dep_time'].apply(lambda x: datetime.strptime(x, '%I:%M %p'))

def is_delayed(row):
    scheduled_time = row['sched_dep_time']
    actual_time = row['act_dep_time']
    return actual_time > scheduled_time

df['is_delayed'] = df.apply(is_delayed, axis=1)

