ALTER TABLE flights
RENAME COLUMN act_arr_time TO act_arr_time_raw;

CREATE OR REPLACE FUNCTION clean_time(time text) RETURNS text AS $$
    SELECT REPLACE(REPLACE(REPLACE($1, ':', ''), '_', ''), ' ', '') as result;
$$ LANGUAGE plpgsql;

UPDATE flights SET act_arr_time = clean_time(act_arr_time_raw);
```

2. Create a new column 'act_arr_time_formatted' to store the formatted time in HH:MM format. This will allow for easier comparison and analysis of times.

