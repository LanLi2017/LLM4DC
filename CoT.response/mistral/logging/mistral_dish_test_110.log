   ```python
import re
from datetime import datetime

def create_time_format(time):
    time = re.search(r'(.*?)\s*(.*?)', time).group(2)  # Extract time from string
    if ':' not in time:
        return None
    hour, minute = map(int, time.split(':'))
    am_pm = time.split()[1]
    if am_pm == 'PM' and hour < 12:
        hour += 12
    return datetime.strftime(datetime.combine(datetime.now().date(), datetime.time(hour, minute)), '%I:%M %p')

def categorize_flight(row):
    time = create_time_format(row['Inst_time'])
    if time:
        row['flight'] = 'A.M.' if int(time.split()[1]) < 12 else 'P.M.'
    return row

# Loop through the data and categorize each flight
