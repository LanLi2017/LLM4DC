# Calculate the delay (in minutes) for each flight
delay = [(df['act_dep_time'][i] - '00:00').total_seconds() / 60 for i in range(len(df))]

# Calculate the average delay per flight
avg_delay = sum(delay) / len(delay)

print('Average delay (in minutes):', avg_delay)
```
