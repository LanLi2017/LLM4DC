    average_price = price_sum / popular_dishes[popular_dishes['dish'] == dish]['times_appeared'].sum()
    average_prices[dish] = round(average_price, 2)

print("Top 10 most popular dishes and their average prices:")
for dish, avg_price in sorted(average_prices.items(), key=lambda x: x[1], reverse=True):
    print(f"{dish}: ${avg_price}")
```
