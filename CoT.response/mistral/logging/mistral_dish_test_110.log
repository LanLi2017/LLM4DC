# Function to convert AM/PM to 24-hour format
def am_pm_to_24(time):
    if time[-2:] == "AM":
        return time[:-2]
    elif time[-2:] == "PM":
        hours = int(time[:-2])
        return f"{hours + 12}:{time[:-2]}"
    else:
        raise ValueError("Invalid time format")

# Apply the function to convert AM/PM times in the DataFrame
df['act_dep_time'] = df['act_dep_time'].apply(am_pm_to_24)
df['sched_dep_time'] = df['sched_dep_time'].apply(am_pm_to_24)

# Convert the times to datetime objects
df['act_dep_time'] = pd.to_datetime(df['act_dep_time'], format='%H:%M')
df['sched_dep_time'] = pd.to_datetime(df['sched_dep_time'], format='%H:%M')

# Fill NaN values in sched_dep_time with 00:00
df['sched_dep_time'].fillna(pd.to_datetime('00:00'), inplace=True)

# Calculate the difference between actual and scheduled departure times
df['delay'] = df['act_dep_time'] - df['sched_dep_time']

# Convert delay to minutes (since timedelta returns seconds)
df['delay'] = df['delay'].apply(lambda x: int(x.total_seconds() / 60))

# Calculate the average delay per flight
avg_delay = df['delay'].mean()
print("Average delay in minutes:", avg_delay)
