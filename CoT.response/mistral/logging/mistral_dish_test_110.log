from datetime import datetime

def fill_missing_times(data):
    filled_data = data.copy()
    for index, row in filled_data.iterrows():
        if pd.isna(row['act_dep_time']):

            scheduled_time = row['scheduled_time']
            try:
                act_dep_time = datetime.strptime(scheduled_time, '%H:%M %p')
                filled_data.at[index, 'act_dep_time'] = act_dep_time.strftime('%H:%M %p')
            except ValueError:
                print("%s" % (Warning: Invalid scheduled time format for row {index}: {scheduled_time}))
    return filled_data
