```python
import datetime as dt

data = [
    "1:39-p.m.",
    "9:21_a.m.",
    "2:35_p.m.",
    "--10:31-a.m.--",
    "11:35-a.m.",
    "7:45_a.m.",
    "--6:45-a.m.--",
    "6:17_p.m.",
    "2:45-p.m.",
    "--7:45-a.m.--",
