            hour, minute = '00', time[0]
        elif len(time) == 2:
            hour, minute = time
        else:
            am_pm = value[-2:].lower()
            if am_pm in ['am', 'a.m.', 'am.']:
                hour = int(value[:-2])
                minute = '00'
            elif am_pm in ['pm', 'p.m.', 'p.m']:
                hour = int(value[:-2]) + 12
                minute = '00'
            else:
                raise ValueError("Invalid AM/PM format")
        return "%s" % ({hour}:{minute})
    elif '-' in value:
        value = re.sub(r'_', '', value)
        time = value.split('-')
        if len(time) == 1:
            hour, minute = '00', time[0]
        elif len(time) == 2:
            hour, minute = time
