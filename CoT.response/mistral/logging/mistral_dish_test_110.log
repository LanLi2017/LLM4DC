    "--2:48-P.M.--", "2:30_P.M."
]

# Initialize variables for the sum of delays and the total number of flights
total_delay = 0
num_flights = len(data)

for i in range(len(data)):
    # Convert time entries to datetime objects
    scheduled_time = dt.datetime.strptime(data[i], "%I:%M %p")
    if "a" in data[i]:
        actual_time = dt.datetime.strptime(data[(i + 1) % len(data)], "%I:%M %p")
    else:
        actual_time = dt.datetime.strptime(data[(i - 1) % len(data)], "%I:%M %p")

    # Calculate the delay (positive for delays, negative for early departures)
    delay = (actual_time - scheduled_time).total_seconds() / 60
    total_delay += delay

# Find the average delay per flight
average_delay = total_delay / num_flights

print("Average delay:", average_delay, "minutes")
