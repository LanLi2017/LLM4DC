data = ["2:30_P.M.", "7:53_a.m.", "--8:29-A.M.--", "--12:30-a.m.--", "11:05_a.m.", "--1:29-p.m.--", "7:30-a.m.", "__11:08_p.m.__", "--7:55-a.m.--", "__7:53_A.M.__", "8:05-a.m.", "6:59_A.M.", "10:15-a.m.", "10:40_A.M.", "__4:16_p.m.__", "--11:25-a.m.--", "6:00_a.m.", "9:15-a.m.", "--10:45-a.m.--", "__12:00_A.M.__", "8:05-a.m."]

for i in range(len(data)):
    data[i] = re.sub(r'[_-]', ':', data[i])
    if ":" in data[i]:
        time = data[i].split(":")
        hours = int(time[0])
        minutes = int(time[1])
        if len(time) > 2:
            am_pm = time[2]
            if am_pm.lower() == "a.m." or am_pm.lower() == "am":
                data[i] = "%s" % ({hours}:{minutes})
            elif am_pm.lower() == "p.m." or am_pm.lower() == "pm":
                data[i] = "%s" % ({(hours + 12)}:{minutes})
    else:
        data[i] = data[i].replace(" ", "")

total_delay = 0
for i in range(len(data)):
    if ":" in data[i]:
        time = data[i].split(":")
        hours = int(time[0])
        minutes = int(time[1])
        if len(time) > 2:
            am_pm = time[2]
            if am_pm.lower() == "a.m." or am_pm.lower() == "am":
                actual_time = "%s" % ({hours}:{minutes})
            elif am_pm.lower() == "p.m." or am_pm.lower() == "pm":
                actual_time = "%s" % ({(hours + 12)}:{minutes})
        else:
            actual_time = data[i]
        delay = int(actual_time) - int(data[i])
        total_delay += delay

average_delay = total_delay / len(data)
print("Average delay in departure times:", average_delay)
return value
