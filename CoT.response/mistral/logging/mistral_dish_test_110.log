    "--5:11-a.m.--",
    "11:10-a.m.",
    "3:19-p.m.",
    "3:50_p.m.",
    "__12:18_p.m.__",
    "__4:31_p.m.__",
    "__12:35_p.m.__",
]

first_time = dt.datetime.strptime("7:53 AM", "%I:%M %p")
durations = []

for time in data:
    if time != "--":
        time = time.replace("_", ":").replace(" ", "T")
        time = dt.datetime.strptime(time, "%H:%M %p").time()
        diff = first_time - dt.datetime.combine(dt.date.min, time)
        durations.append(diff.total_seconds() / 60)

average_duration = sum(durations) / len([t for t in data if t != "--"])
print("Average flight duration:", average_duration, "minutes")
```

