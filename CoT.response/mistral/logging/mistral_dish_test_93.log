def fill_missing_dates(data):
    # Assuming all dishes have been on the menu since the earliest year (1900) and will be removed after the latest year (2022)
    earliest_year = 1900
    latest_year = 2022

    for row in data:
        if not row['first_appeared'] or not row['last_appeared']:
            row['first_appeared'] = earliest_year
            row['last_appeared'] = latest_year

    return data
