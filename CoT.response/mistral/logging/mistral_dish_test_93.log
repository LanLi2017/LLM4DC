INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

# Assuming 'first_appeared' and 'last_appeared' are the column names in the dataframe
def calculate_duration(row):
    first = int(re.search(r'\d{4}', row['first_appeared']).group(0))
    last = int(re.search(r'\d{4}', row['last_appeared']).group(0))

    if last == 0:
        return "Still available"
    else:
        duration = last - first
        return f"{duration} years"

# Apply the function to the dataframe
df['duration'] = df.apply(calculate_duration, axis=1)
return value
