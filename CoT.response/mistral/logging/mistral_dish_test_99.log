 python
import re
from datetime import datetime

def clean_dish_name(name):
    return re.sub(r'[_-\s]+', ' ', name).strip()

def get_date_if_available(name):
    if len(re.findall(r'\d{4}', name)) > 0:
        return datetime.strptime(re.search(r'\d{4}', name).group(), '%Y')
    else:
        return None

def find_pre2000_dishes(data):
    pre2000_dishes = []
    for row in data:
        dish_name = clean_dish_name(row[1])
        date = get_date_if_available(row[1])
        if date and date < datetime(2000, 1, 1):
            pre2000_dishes.append((dish_name, date))
    return pre2000_dishes

