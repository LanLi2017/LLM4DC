        ['Inst', None, None, 'CO-285-DEN-SFO']]

df = pd.DataFrame(data, columns=['Inst', 'Flight_Number', 'Scheduled_Departure', 'Actual_Departure'])

# Add a new column to indicate the airline for each flight
df['Airline'] = df['Flight_Number'].str.extract('^(\w{2})-')[0]

# Create a new column to represent whether the flight is on-time or delayed
df['On-Time Departure'] = df.apply(lambda row: 'On-time' if (row['Actual_Departure'] - row['Scheduled_Departure']) <= timedelta(minutes=15) else 'Delayed', axis=1)

# Calculate the difference between the scheduled departure time and actual departure time for each flight in minutes
df['Departure_Difference'] = df.apply(lambda row: (row['Actual_Departure'] - row['Scheduled_Departure']).total_seconds() / 60, axis=1)
