sorted_df = df.sort_values('Time')  # Sort the data by time in ascending order
evening_flights = []  # Initialize a list to store evening flights

for index, row in sorted_df.iterrows():
    if row['Time'] > pd.to_datetime('18:00:00'):  # Check if the flight time is after 6 PM
        evening_flights.append(row['flight'])  # Add the flight number to the list

print(len(evening_flights))  # Print the number of flights arriving in the evening
```
