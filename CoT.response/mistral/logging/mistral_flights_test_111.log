import pandas as pd
from datetime import datetime, timedelta

# Assuming df is your DataFrame and act_dep_time is your column name
df = pd.read_csv('flights.csv', parse_dates=['act_dep_time'])  # Ensure the dates are in a proper format

def convert_to_24(time):
    if 'A' in time:
        return datetime.strptime(time, '%I:%M %p').replace(hour=int(time[:2]) + 12)
    elif 'a' in time:
        return datetime.strptime(time, '%I:%M %p')
    else:
        return datetime.strptime(time, '%H:%M')

df['act_dep_time'] = df['act_dep_time'].apply(convert_to_24)

delay = (df['act_dep_time'] - df['sched_dep_time']).dt.total_seconds().sum() / len(df)
print("The average delay is:", timedelta(seconds=delay))
```
