flights = [row.split('-') for row in flight_data]
cleaned_flights = []
for flight in flights:
    cleaned_flight = ''
    for part in flight:
        if len(part) > 0:
            cleaned_flight += part + '-'
    # Remove the last hyphen since it is unnecessary after standardization
    cleaned_flight = cleaned_flight[:-1]
    cleaned_flights.append(cleaned_flight)

# Define a regular expression pattern to match flights arriving in the evening (after 6 PM)
evening_pattern = r'(\w+-\d+)-([A-Z]{3}-[A-Z]{2})(\s\d{1,2}:\d{2}-\d{2}:\d{2})$'
evening_flights = [row for row in cleaned_flights if re.search(evening_pattern, row)]

