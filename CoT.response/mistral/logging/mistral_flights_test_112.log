 python
import re
from datetime import datetime

def standardize_datetime(value):
    # Remove non-date characters
    value = re.sub(r'\D', '', value)

    # Split the date and time parts
    parts = value.split()

    # If there's no space, it's a 24-hour format, add 'T' between date and time
    if len(parts) == 1:
        parts = [value, 'T00:00:00']

    # Convert the date part to datetime object
    date_part = datetime.strptime(' '.join(parts[0].split('-') + ['01', '01']) + ' 00:00:00', '%Y-%m-%d %H:%M:%S')

    # Convert the time part to datetime object
    time_part = datetime.strptime(parts[1], '%H:%M:%S')

    # Combine date and time parts
    standardized_datetime = date_part + time_part

    return standardized_datetime.strftime('%Y-%m-%dT%H:%M:%SZ')

# Apply the function to each row in the 'sched_arr_time' column
cleaned_data = dataframe['sched_arr_time'].apply(standardize_datetime)
return value
