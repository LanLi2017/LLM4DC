import re
from datetime import datetime

def standardize_datetime(dt):
    if isinstance(dt, str):
        # Handle different formats
        if dt.count('/') == 3:
            return datetime.strptime(dt, '%m/%d/%Y %H:%M:%S')
        elif dt.count('-') == 2 or dt.count('-') == 3:
            return datetime.strptime(dt.replace('/', '-'), '%Y-%m-%d %H:%M:%S')
        elif dt.count('T') == 1:
            return datetime.strptime(dt, '%Y-%m-%d %H:%M:%S%z')
        else:
            raise ValueError("Invalid date/time format")
    else:
        return dt

def standardize_column(df, column):
    df[column] = df[column].apply(standardize_datetime)
    return df

# Assuming df is your DataFrame and 'sched_dep_time' is the column to be processed.
