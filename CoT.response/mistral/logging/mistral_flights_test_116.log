 jython:import datetime

def is_valid_flight(flight):
    flight = flight.split('-')
    if len(flight) != 4:
        return False

    departure, _ , arrival, _ = flight
    try:
        departure_time = datetime.datetime.strptime(departure, '%s-%s' % ('%Y-%m-%d %H:%M'))
        arrival_time = datetime.datetime.strptime(arrival, '%s-%s' % ('%Y-%m-%d %H:%M'))
    except ValueError:
        return False

    if departure_time > arrival_time:
        return False

    return True

