```python
import pandas as pd

# Assuming df is your DataFrame
df = pd.read_csv('your_datafile.csv')

def check_duration(row):
    if row['arr_time'] < row['act_dep_time']:
        return True  # Unrealistic duration
    else:
        return False

# Apply the function to the entire dataset
df['unrealistic_duration'] = df.apply(check_duration, axis=1)

# Fill missing values in act_dep_time column with scheduled departure time
scheduled_departure = df.groupby('flight_name')['sched_dep_time'].mean()
df['act_dep_time'].fillna(df['flight_name'].map(scheduled_departure), inplace=True)

# Convert act_dep_time to a consistent format (e.g., ISO 8601 or YYYY-MM-DD HH:MM)
df['act_dep_time'] = pd.to_datetime(df['act_dep_time']).dt.strftime('%Y-%m-%d %H:%M')
```
