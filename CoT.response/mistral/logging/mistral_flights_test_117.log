import pandas as pd

# Assuming df is your DataFrame
df['act_arr_time'] = pd.to_datetime(df['act_arr_time'], format='%Y-%m-%dT%H:%M:%SZ')
df['scheduled_dep_time'] = pd.to_datetime(df['scheduled_dep_time'], format='%Y-%m-%dT%H:%M:%SZ')

# Group by airline and filter on-time arrivals
grouped = df.groupby('airline')\
            .filter(lambda x: (x['act_arr_time'] - x['scheduled_dep_time']).dt.total_seconds() <= 900)

# Count the number of on-time arrivals for each airline and add it as a new column
grouped['on_time_count'] = grouped.groupby('airline').cumcount() + 1
```

