import pandas as pd
from datetime import datetime, timedelta

# Assuming df is your DataFrame
df = pd.read_csv('yourfile.csv')

# Filter rows with valid act_dep_time values
df = df[pd.notnull(df['act_dep_time'])]

# Parse act_dep_time column into datetime format
df['act_dep_time'] = pd.to_datetime(df['act_dep_time'])

# Extract carrier from the source column (assuming it's always the first word)
df['carrier'] = df['source'].str.extract(r'(.*?)\s+')

# Calculate difference between act_dep_time and actual arrival time or act_arr_dt if available, otherwise use act_arr_dt
df['diff'] = df.apply(lambda row: (row['act_arr_time'] if not pd.isnull(row['act_arr_time']) else row['act_arr_dt']) - row['act_dep_time'], axis=1)

# Filter for on-time arrivals (within 15 minutes of scheduled departure time)
df = df[df['diff'].apply(lambda x: abs(x.total_seconds()) <= timedelta(minutes=15).total_seconds())]

# Count the number of on-time arrivals for each carrier
on_time_arrivals = df.groupby('carrier')['act_dep_time'].count()
print(on_time_arrivals)
```
