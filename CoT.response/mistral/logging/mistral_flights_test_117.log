    on_time = (actual_times - scheduled_times).dt.total_seconds() / 60
    group['Airline_OnTimeArrivals'] = [int((x < 15) or (x > -15)) for x in on_time]

# Sum the Airline_OnTimeArrivals column to get the total number of on-time arrivals for each airline carrier
