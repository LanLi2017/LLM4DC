df['Arrival'] = pd.to_datetime(df['Arrival'])

# Create a new column for duration (in minutes)
df['Duration'] = ((df['Arrival'] - df['Departure']).dt.total_seconds() / 60).astype(int)

# Find flights with unrealistic durations (e.g., arrival before departure)
mask = df['Duration'] < 0
unrealistic_flights = df[mask]
