```python
import datetime as dt

# Assuming flights_data is your dataframe containing all the flight information
flights_data = ... # load your data here

def get_delay(row):
    scheduled_time = dt.datetime.strptime(row['scheduled_dep_time'], "%I:%M %p")
    actual_time = dt.datetime.strptime(row['act_dep_time'], "%I:%M %p")
    return (actual_time - scheduled_time).total_seconds() / 60

flights_data['delay'] = flights_data.apply(get_delay, axis=1)
airlines = flights_data['carrier'].value_counts()
most_delayed_airline = airlines[airlines.index[0]] if len(airlines) > 0 else "No data available"
print("The airline with the most delayed flights is:", most_delayed_airline)
```

