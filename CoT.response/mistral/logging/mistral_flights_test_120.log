def parse_time(time):
    if len(time) > 5 and time[-2] == "_":
        am_pm = time[-3:]
        hour = int(time[:-3])
        if am_pm[0] in ["A", "P"]:
            if am_pm[1] == "M":
                return hour + 12
            else:
                return hour
        else:
            return hour - 12
    else:
        return datetime.strptime(time, "%I:%M %p").hour

def get_airline_delayed_flights(data):
    flights = {}
    for flight in data:
        airline = flight[0].split(" ")[1]
