import datetime
def standardize_date_time(value):
    if isinstance(value, str):
        try:
            return datetime.datetime.strptime(value, "%Y-%m-%d %H:%M:%S").strftime("%Y-%m-%d %H:%M")
        except ValueError:
            pass # If the format is not in Y-m-d H:M:S, it will be passed as it is.
    return value

data = [
    "march 31, 1900 20:39",
    "1900-03-31 10:55:00",
    "1900-03-31 15:36:00",
    "03-31-1900 12:12:00",
    "1900-03-31T14:55:00Z",
    "1900-03-31t14:10:00z",
    "1900-03-31t07:30:00z",
    "1900-03-31t15:31:00z",
    "1900-03-31t14:48:00z",
    "1900-03-31T06:02:00Z",
    "1900-03-31T15:31:00Z",
    "1900-03-31T16:29:00Z",
    "1900-03-31t11:05:00z",
    "Mar 31, 1900 20:25",
    "1900-03-31t12:13:00z",
    "1900-03-31T12:13:00Z",
    "1900-03-31t17:22:00z",
    "1900-03-31t10:10:00z",
    "31-03-1900 19:15:00",
    "1900-03-31T07:31:00Z",
    "1900-03-31T07:25:00Z",
    "1900-03-31T18:30:00Z",
    "1900-03-31T19:15:00Z",
    "1900.03.31 20:23",
    "1900-03-31T11:40:00Z",
    "1900-03-31t16:25:00z",
]

for row in data:
    print(standardize_date_time(row))
return value
