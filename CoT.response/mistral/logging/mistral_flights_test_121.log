# Calculate the difference between departure time and arrival time for each flight
df['duration'] = df['act_arr_time'].apply(lambda x: (x - df['departure_time'].max()).total_seconds() / 3600)

# Identify flights with unrealistic durations (arrival before departure time)
unrealistic_durations = df[df['duration'] < 0]
print(unrealistic_durations)
