INFO:root:#TASK III: generate regexr arguments: 

 jython:from datetime import datetime

 def convert_time_to_numeric(value):
     try:
         return int(datetime.strptime(value, "%Y-%m-%d %H:%M:%S").strftime("%H"))
     except ValueError:
         return None

 # Assuming the column is named 'act_arr_time'
 grouped = df['act_arr_time'].apply(convert_time_to_numeric).groupby(level=0).max()

 # To get the hour with the highest number of on-time arrivals
 max_hour = grouped[grouped == grouped.max()].index[0]
 return max_hour
return value
