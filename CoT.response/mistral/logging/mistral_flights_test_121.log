df['standardized_time'] = df['act_dep_time'].str.replace('__', '').str.replace('-', 'T')
df['standardized_time'] = pd.to_datetime(df['standardized_time'], format='%H:%M %p')
df['standardized_time'] = df['standardized_time'].dt.strftime('%H:%M-%p')
df['act_dep_time'] = df['standardized_time']
df.drop(columns=['standardized_time'], inplace=True)

# Perform trend analysis on the modified 'act_dep_time' column
hourly_departures = df['act_dep_time'].str.split(':').str[0].astype(int)
delayed_hours = hourly_departures - hourly_departures.shift()
trend = delayed_hours.rolling(window=3).mean().fillna(0)
print(trend)
