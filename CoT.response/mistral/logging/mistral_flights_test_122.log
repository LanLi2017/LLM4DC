INFO:root:#TASK III: generate regexr arguments: 

 python
import re
from datetime import datetime, timedelta

def calculate_duration(value):
    # Split the flight code and times
    flight_code, departure_time, arrival_time = value.split('-')

    # Parse the departure and arrival times in HH:MM format
    departure_time = datetime.strptime(departure_time, '%H:%M')
    arrival_time = datetime.strptime(arrival_time, '%H:%M')

    # Calculate the duration between the two times
    duration = arrival_time - departure_time

    # Check if the calculated duration is realistic (e.g., more than 24 hours)
    if duration > timedelta(hours=24):
        return f"{flight_code}-{departure_time.strftime('%H:%M')}-{arrival_time.strftime('%H:%M')}-unrealistic"
    else:
        return value  # If the duration is realistic, return the original flight code and times

# Apply the function to each row in the table
flights = [
    "CO-52-IAH-LAX",
    "AA-789-ORD-DEN",
    "AA-1544-SAN-ORD",
    "AA-3468-CVG-MIA",
    "AA-3823-LAX-DEN",
    "CO-62-IAH-EWR",
    "AA-616-DFW-DTW",
    "UA-257-JFK-SFO",
    "AA-2050-ORD-MIA",
    "UA-1500-IAH-GUA",
    "AA-1640-MIA-MCO",
    "UA-382-IAD-LAX",
    "AA-2312-DFW-DTW",
    "AA-1640-MIA-MCO",
    "AA-3468-CVG-MIA",
    "AA-3786-IAH-ORD",
    "AA-4344-ORD-DTW",
    "AA-85-JFK-SFO",
    "AA-1221-MCO-ORD",
    "UA-1500-IAH-GUA",
    "AA-1640-MIA-MCO"
]

flights_with_duration = [regexr_transform(flight, r'(.*)-(.*)-(.*)-(.*)', calculate_duration) for flight in flights]

# Print the results
for flight in flights_with_duration:
    print(flight)
return value
