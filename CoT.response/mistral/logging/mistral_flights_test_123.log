```python
import pandas as pd

# Assuming df is your DataFrame and sched_dep_time and actual_dep_time are columns in it
df['sched_dep_time'] = pd.to_datetime(df['sched_dep_time'], format='%I:%M %p')
df['actual_dep_time'] = pd.to_datetime(df['actual_dep_time'], format='%H:%M')

# Fill NaN values with the scheduled departure time for actual_dep_time column
df['actual_dep_time'].fillna(df['sched_dep_time'], inplace=True)

# Calculate delay in minutes if both are provided, otherwise leave it as NaN
df['delay'] = (df['actual_dep_time'] - df['sched_dep_time']).dt.total_seconds() / 60

# Group by hour of the day and calculate average delay per hour
grouped = df.groupby(df['sched_dep_time'].dt.hour, as_index=False)['delay'].mean()

# Visualize the results using a bar chart or line graph
import matplotlib.pyplot as plt
plt.bar(grouped.index, grouped)
plt.xlabel('Hour of the Day')
plt.ylabel('Average Delay (minutes)')
plt.title('Trend of Delayed Departures by Hour of the Day')
plt.show()
```
