 jython:import re
jython:import re

def standardize_time(value):
    return re.sub(r'[_]', '', value).upper()

def extract_hour(value):
    match = re.search(r'(0?[1-9]|[12][0-9]|3[01])', value)
    if match:
        return match.group()
    else:
        return None

def count_on_time(data, hour):
    return sum(1 for time in data if extract_hour(time) == hour and ':' not in time)

def find_max_on_time(data):
    hours = set()
    max_count = 0
    max_hour = None

    for time in data:
        hour = extract_hour(time)
        if hour:
            hours.add(hour)

    for hour in hours:
        count = count_on_time(data, hour)
        if count > max_count:
            max_count = count
            max_hour = hour

    return max_hour, max_count
