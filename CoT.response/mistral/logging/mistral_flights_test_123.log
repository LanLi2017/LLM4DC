INFO:root:#TASK III: generate regexr arguments: 

 jython:import re
jython:import re

def regexr_transform(column):
    if column == 'act_dep_time':
        return_list = []
        for value in column:

            cleaned_value = re.sub(r'[- ]+', ' ', value).strip()
            time_format = cleaned_value.split()

            if len(time_format) == 1:

                hour = int(cleaned_value)
                am_pm = 'AM' if hour < 12 else 'PM'
                twelve_hour_time = hour % 12 or 12
                return_list.append("%s" % ({twelve_hour_time}:00 {am_pm}))
            elif len(time_format) == 2:

                hour = int(time_format[0])
                minute = time_format[1]
                am_pm = time_format[2].upper()

                if am_pm == 'AM' and hour < 12:
                    twelve_hour_time = hour
                elif am_pm == 'PM' and hour >= 12:
                    twelve_hour_time = hour - 12
                else:
                    twelve_hour_time = hour + 12

                return_list.append("%s" % ({twelve_hour_time}:{minute} {am_pm}))
            else:

                cleaned_value = re.sub(r'[- ]+', ' ', value).strip()
                time_format = cleaned_value.split()
                hour = int(time_format[1])
                minute = time_format[2]
                am_pm = time_format[3].upper()

                if am_pm == 'AM' and hour < 12:
                    twelve_hour_time = hour
                elif am_pm == 'PM' and hour >= 12:
                    twelve_hour_time = hour - 12
                else:
                    twelve_hour_time = hour + 12

                return_list.append("%s" % ({twelve_hour_time}:{minute} {am_pm}))
        return return_list

This expression standardizes the format of the act_dep_time column by converting all times to a uniform 12-hour or 24-hour format (with or without AM/PM) and removing unnecessary hyphens.
