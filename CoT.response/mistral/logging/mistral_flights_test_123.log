jython:import datetime

pattern = r'(\d{1,2}:\d{2}(?:\s*(a|p)\.m))'

def clean_time(value):

    match = re.search(pattern, value)
    if match:

        time = datetime.datetime.strptime(match.group(0), '%H:%M %p')

        return int(time.hour)
    else:

        return None

