def format_flight(row):
    flight = row.split("|")[1]  # Extract flight information from the current row
    flight_details = flight.split("-")  # Split the flight details by '-'
    airline, flight_number, origin, destination = flight_details
    scheduled_time = row.split("|")[3]  # Extract scheduled time
    actual_time = "" if row.split("|")[4] == "" else row.split("|")[4].strip()  # Extract actual time if available, otherwise set as empty string
    return f"{airline}-{flight_number}-{origin}-{destination} ({scheduled_time}) {actual_time}"

# Apply the function to each row in the data
