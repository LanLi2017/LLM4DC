INFO:root:#TASK III: generate regexr arguments: 

 python
import pandas as pd
from collections import Counter

# Assuming the data is already loaded into a DataFrame named df
df['hour'] = pd.to_datetime(df['sched_arr_time']).dt.hour

# Define on-time arrival (within 15 minutes of scheduled time)
on_time = lambda x: abs(x - df['hour']) <= 15

# Count the number of on-time arrivals for each hour
on_time_counts = Counter(df['hour'][on_time(df['sched_arr_time'])])

# Find the hour with the highest number of on-time arrivals
max_hour = max(on_time_counts, key=on_time_counts.get)
print(f"The hour with the highest number of on-time arrivals is {max_hour}.")
return value
