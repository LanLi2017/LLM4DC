 jython:from datetime import datetime

def calculate_time_difference(scheduled_time, actual_time):
    scheduled = datetime.strptime(scheduled_time, "%H:%M")
    actual = datetime.strptime(actual_time, "%H:%M")
    difference = (actual - scheduled).seconds / 60
    return int(difference)

def combine_and_calculate(value):
    scheduled_arr_time = value.split(' ')
    if len(scheduled_arr_time) == 2:
        scheduled, actual = scheduled_arr_time
        difference = calculate_time_difference(scheduled, actual)
        return str(difference) + ' minutes'
    else:
        return value

regexr_transform('sched_arr_time', 'jython:\nimport re\nreturn combine_and_calculate(value)')
return value
