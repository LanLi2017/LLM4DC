INFO:root:#TASK III: generate regexr arguments: 

 python:import re

def standardize_flight_number(flight):
    # Remove hyphens, spaces, and parentheses from flight number
    cleaned_flight = re.sub(r'[\s()-]', '', flight)

    # Split the cleaned flight number into flight code and destination
    flight_code, destination = cleaned_flight.split('-')

    # If there is no hyphen, assume that the flight code is the entire flight number
    if '-' not in cleaned_flight:
        flight_code = cleaned_flight
        destination = ''

    return flight_code, destination

# Apply the function to each row and store the results in a list of tuples
flights = [standardize_flight_number(flight) for flight in flights]
return value
