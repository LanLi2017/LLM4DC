    scheduled_arrival_time = row[1].split("|")[2]
    actual_arrival_time = row[1].split("|")[3] if len(row[1].split("|")) > 3 else scheduled_arrival_time

    try:
        scheduled_datetime = dt.datetime.strptime(scheduled_arrival_time, "%Y-%m-%dT%H:%M:%SZ")
        actual_datetime = dt.datetime.strptime(actual_arrival_time, "%Y-%m-%dT%H:%M:%SZ")
    except ValueError:
        scheduled_datetime = dt.datetime.strptime(scheduled_arrival_time, "%Y-%m-%d %H:%M:%S")
        actual_datetime = dt.datetime.strptime(actual_arrival_time, "%Y-%m-%d %H:%M:%S")

    if scheduled_datetime != actual_datetime:
        status = "delayed"
    else:
        status = "on-time"

    print(f'{flight}: {status}')
