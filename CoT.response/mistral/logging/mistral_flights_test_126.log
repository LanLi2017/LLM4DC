# Convert time format to 24-hour format
def convert_time(time):
    if '-' in time:
        return time.replace('-', 'T').replace('a.', 'T').replace('p.', 'T').replace(' ', 'T').replace('A.', 'T')
    else:
        return time + 'T00:00:00'

df['scheduled_arr_time'] = df['scheduled_arr_time'].apply(convert_time)
df['act_arr_time'] = df['act_arr_time'].apply(convert_time)

# Calculate the difference between scheduled and actual arrival time
def calculate_difference(row):
    scheduled = pd.to_datetime(row['scheduled_arr_time'])
    act = pd.to_datetime(row['act_arr_time'])
    return timedelta(minutes=(scheduled - act).total_seconds() / 60)

df['difference'] = df.apply(calculate_difference, axis=1)

# Format the difference in minutes
def format_difference(diff):
    if diff < 0:
        return f'-{abs(diff).minutes:02d}'
    else:
        return f'+{diff.minutes:02d}'

df['difference'] = df['difference'].apply(format_difference)
