    'row': [34, 50, 35, 20, 18, 21, 32, 14, 8, 37, 39, 38, 45, 43, 40, 19, 30, 5, 12, 9, 28],
    'scheduled_arr_time': ['6:15_p.m.', '9:45-a.m.', '1:19-p.m.', '5:17-p.m.', '7:39_P.M.', '11:06_a.m.', '5:43_p.m.', '12:29-a.m.', '7:25_P.M.', '3:30-p.m.', '1:27-p.m.', '10:16_a.m.', '9:28_A.M.', '12:29_A.M.', '4:44_p.m.', '2:10_p.m.', '4:44_p.m.', '2:00-p.m.', '3:14-p.m.', '4:56_P.M.'],
