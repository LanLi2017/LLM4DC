INFO:root:#TASK III: generate regexr arguments: 

 jython:import re
jython:import re

 def standardize_hospital_type(value):
     if re.search(r'acute care hospitals', value, re.IGNORECASE):
         return 'Acute Care Hospitals'
     elif re.search(r'acute_care_hospitals', value, re.IGNORECASE):
         return 'Acute Care Hospitals'
     else:
         return value

 def filter_and_count_emergency_services(data):
     emergency_services = [row for row in data if re.search(r'emergency', standardize_hospital_type(row[0]))]
     county_dict = {}

     for row in emergency_services:
         county = row[1].strip()
         if county not in county_dict:
             county_dict[county] = 1
         else:
             county_dict[county] += 1

     sorted_counties = sorted(county_dict.items(), key=lambda x: x[1], reverse=True)[:3]

     for i, (county, count) in enumerate(sorted_counties):
         print(f'{i+1}. {county}: {count}')
