 jython:import re

# Standardize the representation of emergency services to a consistent format (e.g., "YES", "NO")
def standardize_emergency(value):
  if value.upper() in ["YES", "YES", "Y", "TRUE", "T"]:
    return "Yes"
  elif value.upper() in ["NO", "NO", "N", "FALSE", "F"]:
    return "No"
  else:
    return value

# Apply the standardization function to each cell in the EmergencyService column
def regexr_transform(column):
  return [standardize_emergency(value) for value in column]
return value
