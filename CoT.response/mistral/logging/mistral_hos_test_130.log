INFO:root:#TASK III: generate regexr arguments: 

 jython:import re
jython:import re

def regexr_transform(column):
    if column == 'HospitalType':
        return_list = []
        for value in column:

            cleaned_value = re.sub(r'\s+', ' ', value).lower()

            if 'acute care hospitals' in cleaned_value:
                return_list.append('acute care hospitals')

        count = {}
        for value in return_list:
            if value not in count:
                count[value] = 1
            else:
                count[value] += 1

        sorted_count = sorted(count.items(), key=lambda x: x[1], reverse=True)[:3]

        top_hospitals = [x[0] for x in sorted_count]
        top_counts = [x[1] for x in sorted_count]

        return f'Top 3 counties offering emergency services: {", ".join(top_hospitals)} with counts: {", ".join(str(x) for x in top_counts)}'
