 jython:import re

def standardize_hospital_owner(value):
    # Remove hyphens and spaces
    value = re.sub(r'[- ]+', ' ', value)

    # Convert to lowercase
    value = value.lower()

    # Standardize hospital types
    if 'government' in value:
        return 'government'
    elif 'hospital district or authority' in value:
        return 'government'
    elif 'local' in value:
        return 'government - local'
    elif 'state' in value:
        return 'government - state'
    elif 'voluntary non-profit - private' in value:
        return 'private'
    elif 'church' in value:
        return 'voluntary non-profit - church'
    elif 'other' in value:
        return 'voluntary non-profit - other'
    else:
        # If the hospital owner is not recognized, return the original value
        return value

return standardize_hospital_owner(value)
return value
