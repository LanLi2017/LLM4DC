def normalize_ownership_types(value):
    if 'government' in value:
        return 'Government'
    elif 'voluntary non-profit' in value:
        return 'Voluntary Non-Profit'
    elif 'private' in value:
        return 'Private'
    elif 'prioprietary' in value:
        return 'Proprietary'
    else:
        return value

def clean_hospital_owner(value):
