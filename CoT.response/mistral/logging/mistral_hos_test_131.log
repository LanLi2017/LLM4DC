def standardize_hospital_owner(value):

    value = re.sub(r'[- ]+', ' ', value).lower()

    words = value.split()

    if 'government' in words or 'voluntary non-profit' in words:

        if 'federal' in words:
            return 'GOVERNMENT - FEDERAL'
        elif 'state' in words:
            return 'GOVERNMENT - STATE'
        elif 'district' in words or 'authority' in words:
            return 'GOVERNMENT - HOSPITAL DISTRICT OR AUTHORITY'
        else:
            return 'GOVERNMENT'
    elif 'church' in words:
        return 'VOLUNTARY NON-PROFIT - CHURCH'
    elif 'private' in words:
        return 'VOLUNTARY NON-PROFIT - PRIVATE'
    else:
        return 'PROPRIETARY'

