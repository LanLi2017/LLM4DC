def standardize_government(value):
    if value.lower().startswith('voluntary non-profit'):
        return 'Voluntary Non-Profit'
    elif value.lower() == 'proprietary':
        return 'Proprietary'
    else:
        match = re.search(r'government - (.*)', value)
        if match:
            return 'Government - ' + match.group(1).capitalize()
        else:
            return 'Unknown'

