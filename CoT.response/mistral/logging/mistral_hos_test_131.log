              ownership_types[value] = set()
          for row in range(len(column)):
              if column[row] == value:
                  # Check if the hospital is part of a clinic or has 'inc' at the end, and add it to the appropriate set
                  if 'clinic' in value or 'inc' in value:
                      ownership_types[value].add('Clinic')
                  elif 'hospital' in value:
                      ownership_types[value].add('Hospital')
                  else:
                      ownership_types[value].add('Other')

  # Filter the original dataframe to include only hospitals with at least three different ownership types
  filtered_data = []
  for row in range(len(column)):
      if column[row] in ownership_types and len(ownership_types[column[row]]) >= 3:
          filtered_data.append(column[row])
return value
