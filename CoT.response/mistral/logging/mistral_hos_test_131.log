 jython:import re

def standardize_hospital(value):
    # Remove underscores, spaces, and special characters
    value = re.sub(r'[_ ]+', ' ', value)
    value = re.sub(r'\W', '', value)

    # Convert to lowercase
    value = value.lower()

    return value

# Apply the function to each cell in the HospitalType column
hospital_type_cleaned = df['HospitalType'].apply(standardize_hospital)

# Count the number of rows where the cleaned HospitalType is 'acute care hospitals'
num_acute_care_hospitals = (hospital_type_cleaned == 'acute care hospitals').sum()
return value
