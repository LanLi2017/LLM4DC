 jython:import re
jython:import re

def standardize_hospital_owner(value):

    value = re.sub(r'\s+', ' ', value)

    value = value.capitalize().lower()

    value = re.sub(r'-', ' ', value)

    if 'government' in value:
        value = 'government'
    elif 'voluntary non-profit' in value:
        value = 'voluntary non-profit'
    elif 'private' in value:
        value = 'private'
    elif 'church' in value:
        value = 'church'
    elif 'osher' in value:
        value = 'other'
    else:
        value = 'proprietary'

    return value

from collections import defaultdict, Counter

data = [
    "PROGRIETARY",
    "PROPRIfTARY",
    "VOLUNTARY NON-PROFIT - CHURCH",
    "GOVERNMENT_-_HOSPITAL_DISTRICT_OR_AUTHORITY",
    "PROPRIETARY",
    "GOVERNMENT_-_HOSPITAL_DISTRICT_OR_AUTHORITY",
    "PROPRIETARY",
    "voluntary non-profit - private",
    "PROPRIETARY",
    "GOVERNMENT - LOCAL",
    "GOVERNMENT - HOSPITCL DISTRICT OR AUTHORITY",
    "VOLUNTARY_NON-PROFIT_-_PRIVATE",
    "VOLUNTARY_NON-PROFIT_-_PRIVATE",
    "proprietary",
    "VOLUNTARY NON-PROFIT - PRIVATE",
    "GOVERNMENT_-_LOCAL",
    "GOVERNMENT - HOSPITAL DISTRICT OR AUTHORITY",
    "government - hospital district or authority",
    "VOLUNTARY NONMPROFIT - CHURCH",
    "VOLUNTARY NON-PROFIT - OsHER"
]

hospital_types = defaultdict(lambda: [])
for name in data:
    hospital_types[standardize_hospital_owner(name)].append(name)

average_lengths = {type_: sum([len(name) for name in hospital_types[type_]]) / len(hospital_types[type_]) for type_ in hospital_types}
print(average_lengths)


