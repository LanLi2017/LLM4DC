# Remove unnecessary punctuation
value = re.sub(r'\W+', '_', value)

# Ensure only one underscore per word
value = re.sub(r'_+', '_', value)

# Ensure the final result starts with "hospital"
if value != 'hospital':
    value = 'hospital_' + value
return value
