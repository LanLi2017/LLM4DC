def standardize_hospital_owner(value):
    if 'government' in value and 'local' in value:
        return 'Local Government'
    elif 'government' in value:
        return 'Government'
    elif 'voluntary non-profit - private' in value:
        return 'Voluntary Non-Profit (Private)'
    elif 'voluntary non-profit - church' in value:
        return 'Voluntary Non-Profit (Church)'
    elif 'proprietary' in value:
        return 'Proprietary'
    else:
        return value

return standardize_hospital_owner(value)

