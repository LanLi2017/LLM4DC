def standardize_hospital_owner(value):

    if "government" in value.lower():
        return "Government"

    elif "non-profit" in value.lower():
        return "Non-Profit"

    elif "church" in value.lower():
        return "Church"

    elif "proprietary" in value.lower():
        return "Proprietary"

    else:
        return re.sub(r'\s+', ' ', value).strip().title()

standardized_data = df['HospitalOwner'].apply(standardize_hospital_owner)


