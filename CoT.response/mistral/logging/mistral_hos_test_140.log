 jython:import re
jython:import re

 government_pattern = r'(government|GOVERNMENT|Government|gov|GOV)'
 hospital_district_or_authority_pattern = r'hospital district or authority|Hospital District Or Authority|Hospital District or Authority'

 def standardize(value):
     value = value.lower()
     value = re.sub(government_pattern, 'government', value)
     value = re.sub(hospital_district_or_authority_pattern, 'hospital district or authority', value)
     return value

 def consistent_representation(value):
     if value in ['private', 'proprietary']:
         return 'Private'
     elif value == 'voluntary non-profit':
         return 'Voluntary Non-Profit'
     else:
         return value

 def clean_hospital_owner(df):
     df['HospitalOwner'] = df['HospitalOwner'].apply(standardize)
     df['HospitalOwner'] = df['HospitalOwner'].apply(consistent_representation)

 df = pd.DataFrame({'HospitalOwner': ['GOVERNMENT - HOSPITAL DISTRICT OR AUTHORITY', 'GOVERNMENT - HOSPITAL DISTRICT OR AUTHORIKY', 'government - hospital district or authority', 'PROPRIGTARY', 'VOLUNTARY NON-PROFIT - OTHER', 'proprietary', 'GOVERNMENT - HOSPITAL DISTRICT OR AUTHORITY', 'VOLUNTARY NON-PROFIT - PRIVATE', 'government - local', 'VOLUNTARY NON_PsOFIT - OTHER', 'government - hospital district or authority', 'PRIVATE', 'voluntary non-profit - private', 'GOVERNMENT_-_FEDERAL', 'VOLUNTARY_NON-PROFIT_-_PRIVATE', 'VOLUNTARY NON-PROFIT - OTHWR', 'PRIVATE', 'PROPiIETARY', 'government - federal', 'PRIVATE']})
 df = clean_hospital_owner(df)
 print(df)
   

