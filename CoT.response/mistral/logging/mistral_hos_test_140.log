def regexr_transform(column):
    if column == 'HospitalType':
        return_list = []
        for value in column:

            cleaned_value = re.sub(r'\s+', ' ', value).strip().upper()

            if 'ACUTE' in cleaned_value and 'HOSPITALS' in cleaned_value:
                return_list.append(cleaned_value)
            else:
                return_list.append('Missing')
        return return_list


