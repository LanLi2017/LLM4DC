value = re.sub(r'proprietary', 'government', value)
value = re.sub(r'proprAietary', 'government', value)
value = re.sub(r'proprietarY', 'government', value)
value = re.sub(r'proprietarI', 'government', value)
value = re.sub(r'proprietari', 'government', value)
value = re.sub(r'proprIetary', 'government', value)
value = re.sub(r'proprIetary', 'government', value)
value = re.sub(r'proprietar', 'government', value)
value = re.sub(r'proprietarY', 'government', value)
value = re.sub(r'proprietari', 'government', value)
value = re.sub(r'proprIetar', 'government', value)
value = re.sub(r'proprIetarY', 'government', value)
value = re.sub(r'proprIetari', 'government', value)
value = re.sub(r'proprietarI', 'government', value)
value = re.sub(r'proprIetaryI', 'government', value)
value = re.sub(r'proprIetaryI', 'government', value)
value = re.sub(r'proprIetarI', 'government', value)
value = re.sub(r'proprIetari', 'government', value)
value = re.sub(r'proprietary\s+', 'government', value)

# Remove hyphens and spaces
value = re.sub(r'\s+', '', value)
value = re.sub(r'-', '', value)

# Normalize ownership types
value = re.sub(r'voluntary non-profit - church', 'church', value)
value = re.sub(r'voluntary non-profit - private', 'private', value)
value = re.sub(r'government - hospital district or authority', 'government', value)
value = re.sub(r'government - local', 'local', value)
value = re.sub(r'voluntary non-profit - other', 'other', value)

# Ensure only one ownership type is present
if 'government' in value and ('church' in value or 'private' in value or 'local' in value or 'other' in value):
    value = 'government'
elif 'church' in value:
    value = 'church'
elif 'private' in value:
    value = 'private'
elif 'local' in value:
    value = 'local'
elif 'other' in value:
    value = 'other'

# Ensure all values are lowercase and consistent
value = value.lower()

print(value)
return value
