 jython:import re

def standardize_race(value):
    if value.lower() == 'hispanic/latino':
        return 'Hispanic/Latino'
    elif value.lower() in ['asian', 'a1san', 'aisan']:
        return 'Asian'
    elif value.lower() in ['blak african am', 'blak african amer', 'b.a.a.', 'nativ hawaiian']:
        return 'Black/African American'
    elif value.lower() == 'other':
        return 'Other'
    elif re.search(r'\bwhite\b', value, re.IGNORECASE):
        return 'White'
    else:
        return value

# Apply the function to the column
RaceEthnicity = ['HISPANIC/LATINO', 'ASIN', 'NATVE HAWAIIAN', 'AISAN', 'AS1AN', 'AISAN', 'BLK/AFR AM', 'AS1AN', 'OTHR', 'ASIN', 'BLAK AFRICAN AMER', 'BLAK AFRICAN AMER', 'WH1TE', 'AISAN', 'HISPAIC LTN', 'WHIITE', 'W1TE', 'B.A.A.', 'HISPAIC LTN', 'NTV HWN']
cleaned_RaceEthnicity = [standardize_race(row) for row in RaceEthnicity]
print(cleaned_RaceEthnicity)
return value
