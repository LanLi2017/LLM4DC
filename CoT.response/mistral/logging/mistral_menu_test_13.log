 jython:import pandas as pd

def fill_missing_addresses(df):
    addresses = df[df['Risk'] == '3 (Low)']['Inspection Result'].apply(lambda x: x if x == 'pass' else None)
    addresses_series = pd.Series(data=addresses, index=df.index)
    df['Address'] = df.index.map(addresses_series)
    return df
