INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

 # Define a pattern for matching dollar signs (USD)
 pattern = r'\bUSD\b'

 def regexr_transform(column):
     for value in column:
         # Check if the sponsor name contains USD
         match = re.search(pattern, value)

         # If a match is found, return the sponsor name
         if match:
             return value

 # Apply the function to the 'sponsor' column
 sponsors_accepting_dollars = regexr_transform([
     "Seaboard Railway",
     "Hotel Imperial",
     "RED STAR LINE",
     "HAMBURG-AMERIKA LINIE",
     "The Mouquin Restaurant and Wine Co.",
     "Southern Pacific",
     "Gardner & Smith",
     "COLONIAL HOTEL",
     "R.M.S. Parthia",
     "Wiehl & Widman",
     "Toots Shor",
     "NORDDEUTSCHER LLOYD BREMEN",
     "NIPPON YUSEN KAISHA",
     "Amy's",
     "NORDDEUTSCHERRR LLOYD BREMEN",
     "Waldorf Astoria",
     "COEUR DE LION CAMMANDERY NUMBER TWENTY-THREE KNIGHTS TEMPLAR",
     "Hotel Brevoort",
     "NIPPON YUSEN KAISHA",
     "The Maplewood"
 ])

 # Print the sponsors who accept dollars
 print("Sponsors accepting Dollars:")
 for sponsor in sponsors_accepting_dollars:
     print(sponsor)
return value
