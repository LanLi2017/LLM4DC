INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

 # Standardize 'proprietary'
 proprietary_patterns = ['PROPRIETARY', 'PROPRAETARY', 'IROPRIETARY']
 for pattern in proprietary_patterns:
    HospitalOwner = re.sub(pattern, 'Proprietary', HospitalOwner)

 # Standardize 'non-profit'
 non_profit_patterns = ['VOLUNTARY_NON-PROFIT_-_', 'VOLUNTARY NON-PROFIT - ', 'VOLUNTARY NON-PROFIT_-_', 'VOLUNTARY NON-PROFIT_-_PRIVATE']
 for pattern in non_profit_patterns:
    HospitalOwner = re.sub(pattern, 'Voluntary Non-Profit', HospitalOwner)

 # Standardize hyphen usage
 HospitalOwner = re.sub('[-_]', '_', HospitalOwner)

 # Convert to lowercase for easier comparison
 HospitalOwner = HospitalOwner.lower()

 # Identify government-owned hospitals
 government_hospitals = ['government', 'district', 'authority']
 government_hospitals_patterns = [f'.*{word}.*' for word in government_hospitals]
 government_hospitals_regex = '|'.join(government_hospitals_patterns)

 # Find critical access hospitals primarily owned by the government
 critical_access_government_hospitals = HospitalOwner[HospitalOwner.str.contains(government_hospitals_regex)]
return value
