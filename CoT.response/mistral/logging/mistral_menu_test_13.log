INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

# Define a pattern to match dish names and menu names
pattern = r'(?i)(?:dish|menu) (?:of|from) (?:[a-z]+ \w*)'

def standardize_venue(value):
    # Find all matches in the venue name using the defined pattern
    matches = re.findall(pattern, value)

    # If there are any matches, replace them with a consistent naming convention (e.g., "Dish" or "Menu")
    if matches:
        for match in matches:
            replacement = match.replace('dish', 'Dish').replace('menu', 'Menu')
            value = value.replace(match, replacement)

    return value
return value
