 jython:import requests
from bs4 import BeautifulSoup

url = "https://data.medicare.gov/resource/2yrg-q82t.json"
response = requests.get(url)
data = response.json()

# Filter data for Alabama Critical Access Hospitals
alabama_hospitals = [hospital for hospital in data if hospital['State'] == 'AL']

# Initialize a dictionary to store the city and ownership information
city_ownership = {}

for hospital in alabama_hospitals:
    city = hospital['City']
    ownership = hospital['Ownership']
    if city not in city_ownership:
        city_ownership[city] = []
    city_ownership[city].append(ownership)

# Filter for government-owned hospitals
government_hospitals = [city for city, hospitals in city_ownership.items() if 'Government' in hospitals]

# Transform the City column to include ownership information
expression = f"jinja['|join'](city_ownership[row['City']]) if row['City'] in {government_hospitals} else row['City']"
return value
