INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

def standardize_risk(value):
    if value.startswith("Risk"):
        match = re.search(r'\(([A-Za-z]+)\)', value)
        if match:
            return "Risk 3 - " + match.group(1).capitalize()
        else:
            return "Risk 3 - Invalid"
    else:
        return "Invalid"

# Apply the function to each row in the column
data = [
    "Risk 3-(Low)",
    "Risk 3   (Low)",
    "Risk 1 (High)",
    "Risk 1 (High)",
    "Risk 1 (High)",
    "Risk 2 (Medium)",
    "Risk 1 (High)",
    "Risk 3  (Low)",
    "Risk 3 (LOW)",
    "Risk 3 (LOW);"
]

for row in data:
    print(standardize_risk(row))
return value
