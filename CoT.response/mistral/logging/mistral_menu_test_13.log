INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

# Remove hyphens, spaces, special characters, and convert to lowercase
def standardize_dish(value):
    value = re.sub(r'[-_\.\*\(\)]', '', value)
    value = value.lower()
    return value

# Apply the standardization function to each dish name in the table
data = [
    "--BAKED-FRESH-MACKEREL,-CREOLE--",
    "--cold-ferris-ham--",
    "__BRANDY_PEACHES_PRESERVES__",
    "__*filet_of_sole_with_fresh_spinach_florentine__",
    "--head-lettuce-with-thousand-island-dressing--",
    "tortue-verte-au-marsala",
    "--bread-and-butter-white?--",
    "brandy_(domestic)",
    "borscht_koop",
    "(BEEF)_TAMALE",
    "__coffee_ice_cream,_caramel_sauce__",
    "wehlener-rosenberg,-1907,-1/2-bottle,-bottle",
    "__beef)_tamale__",
    "BROILED-PORK-CHOPS,-APPLE-SAUCE,-VEGETABLE,-POTATO",
    "__breast_of_lamb,_jardiniere__",
    "hot_corn_meal_mush_and_milk",
    "brandy-(domestic)",
    "__potatoes,_sautees_or_stewed__",
    "stuffed-turkey,-cranberry-sauce",
    "__fricandeau_veal_and_olives__"
]

standardized_data = [standardize_dish(dish) for dish in data]

# Count the frequency of each standardized dish name
dish_counts = {}
for dish in standardized_data:
    if dish not in dish_counts:
        dish_counts[dish] = 1
    else:
        dish_counts[dish] += 1

# Find the 5 most popular dishes based on their counts
popular_dishes = sorted(dish_counts.items(), key=lambda x: x[1], reverse=True)[:5]

# Print the 5 most popular dishes and their counts
for dish, count in popular_dishes:
    print(f"{dish}: {count}")
return value
