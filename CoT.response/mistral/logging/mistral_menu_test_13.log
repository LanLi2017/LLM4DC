# Assuming a new column "Risk" is added with values "Low", "Medium", or "High". Similarly, a new column "Inspection Results" is added with values "pass" or "fail".

def clean_address(value):
    # Remove extra spaces and commas
    value = re.sub(r'[\s,]+', ' ', value)

    # Split the address into city, state, and zip code
    city, state, zip = value.split(',')
    city = city.strip()
    state = state.strip().upper()
    zip = zip.strip()

    # Add risk and inspection results columns based on assumptions
    if city == 'CHICAGO':  # Assuming Chicago has low risk and passed inspection
        return f'{city}, {state}, {zip}, Low, pass'

    # If the address is not Chicago, assume it has not been inspected yet or has high risk
    return f'{city}, {state}, {zip}, High, None'

# Apply the clean_address function to each row in the table
