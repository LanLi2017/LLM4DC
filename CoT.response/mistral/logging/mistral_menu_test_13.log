 jython:import re

# Remove punctuation and convert to lowercase
def clean_venue(value):
    return re.sub(r'[.,\s]', '', value.lower())

# Count dish count per menu for each venue
def count_dishes(data, venue):
    return len([row for row in data if clean_venue(row['Venue']) == venue and 'Dish' in row])

# Find top three venues with the highest average dish count per menu
def find_top_venues(data):
    venues = set(data['Venue'])
    venue_counts = {venue: count_dishes(data, venue) for venue in venues}
    averages = {venue: value / len(data) for venue, value in venue_counts.items()}
    top_venues = sorted(averages.items(), key=lambda x: x[1], reverse=True)[:3]

    # Return the name of each venue instead of a tuple
    return [venue[0] for venue in top_venues]

# Apply the clean_venue function to the Venue column
data['Venue'] = data['Venue'].apply(clean_venue)

# Find the top three venues with the highest average dish count per menu
top_venues = find_top_venues(data)
print(top_venues)
return value
