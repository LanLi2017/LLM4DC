INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

# Standardize and normalize the spelling and formatting of "Coffee"
def standardize_coffee(value):
    value = value.lower()
    if 'coffee' in value or 'cofee' in value:
        return 'coffee'
    elif 'cafe' in value:
        return 'cafe'
    else:
        return value

# Remove extra spaces and special characters, and ensure only one space between words
def clean_dba(value):
    value = re.sub(r'\s+', ' ', value)
    value = value.strip()
    value = value.replace('-', '')
    value = value.replace('(', '')
    value = value.replace(')', '')
    return value

# Apply the functions to each row and calculate the inspection passing rate for each brand
def calculate_inspection_passing_rate(data):
    brands = {}
    total_inspections = len(data)

    for row in data:
        dba = clean_dba(row['DBA Name'])
        coffee = standardize_coffee(row['DBA Name'])

        if dba not in brands:
            brands[dba] = {'passing': 0, 'total': 0}

        if coffee == 'coffee' or coffee == 'cafe':
            brands[dba]['passing'] += 1
            brands[dba]['total'] += 1
        else:
            brands[dba]['total'] += 1

    passing_rates = []
    for dba, info in brands.items():
        if info['total'] > 0:
            passing_rate = info['passing'] / info['total']
            passing_rates.append((dba, passing_rate))

    sorted_rates = sorted(passing_rates, key=lambda x: x[1], reverse=True)
    return sorted_rates
return value
