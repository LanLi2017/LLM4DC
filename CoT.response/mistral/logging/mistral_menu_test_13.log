INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

# Standardize capitalization
def standardize_capitalization(value):
  return value.lower().title()

# Remove special characters and spaces
def remove_special_characters_and_spaces(value):
  return re.sub(r'[^\w\s]', '', value).strip()

# Combine the functions to clean the BusinessType column
def clean_business_type(value):
  cleaned_capitalization = standardize_capitalization(value)
  cleaned_special_characters = remove_special_characters_and_spaces(cleaned_capitalization)
  return cleaned_special_characters

# Apply the clean function to each row in the BusinessType column
BusinessType_cleaned = [clean_business_type(row['BusinessType']) for index, row in df.iterrows()]
return value
