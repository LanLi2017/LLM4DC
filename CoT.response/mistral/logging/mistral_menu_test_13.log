 jython:import re

# Remove special characters and spaces from both sides of the string
def clean_string(value):
    return re.sub(r'[^\w\s]', '', value).strip()

# Split the cleaned string into individual dish components using space as delimiter
def split_dish(cleaned_value):
    return cleaned_value.split()

# Count the number of occurrences of each unique dish in the dataset
def count_dishes(data):
    dishes = set()
    dish_counts = {}

    for row in data:
        cleaned_row = clean_string(row)
        if cleaned_row:  # Skip empty rows
            dish_components = split_dish(cleaned_row)
            for component in dish_components:
                dishes.add(component)

    for dish in dishes:
        dish_counts[dish] = data.count(clean_string(f"{dish} "))  # Add space at the end to ensure consistency

    return dish_counts

# Find the 5 most popular dishes based on their counts
def find_popular_dishes(dish_counts):
    sorted_dishes = sorted(dish_counts.items(), key=lambda x: x[1], reverse=True)
    return sorted_dishes[:5]

# Load the dataset from the table contents
