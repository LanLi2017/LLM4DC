  elif re.search(r'\b[A-Z]+\s+DAILY\b', value): # If the value contains 'DAILY', return 'Daily'
    return 'Daily'
  elif re.search(r'\b[A-Z]+\s+ANNUAL\b', value): # If the value contains 'ANNUAL', return 'Annual'
  else: # If the value doesn't match any pattern, return the original value
    return value

# Apply the function to fill missing values in the 'occasion' column
