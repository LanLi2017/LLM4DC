    elif len(date_str) == 8:
        year = int(date_str[:4])
        month = int(date_str[5:7])
        day = int(date_str[8:])
        return f"{year}-{month:02d}-{day:02d}"
    elif len(date_str) == 6 and date_str[-1] in ['-', '.']:
        year = int(date_str[:4])
        month = int(date_str[5:7])
        day = 1
        return f"{year}-{month:02d}-{day:02d}"
    elif len(date_str) == 8 and date_str[-1] in ['/']:
        month, day, year = map(int, date_str.split('/'))
        return f"{year}-{month:02d}-{day:02d}"
    else:
        raise ValueError("Invalid date format")

