 jython:import re

def standardize_page_count(value):
    if value.isdigit():
        return float(value) + 1 # Adding 1 to account for "pages"
    elif 'pages' in value.lower() and re.search(r'\d+', value):
        return float(re.findall(r'\d+', value)[0]) + 1
    else:
        return None

# Apply the function to each row
