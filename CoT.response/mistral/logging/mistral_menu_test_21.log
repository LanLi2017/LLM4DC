  elif re.search(r'\b[A-Z]+\s+TESTIMONIAL\b', value): # If the value contains 'TESTIMONIAL', return the first word before 'TESTIMONIAL'
    return re.sub(r'\s+.*', '', value)
  elif re.search(r'\b[A-Z]+\s+ANNIVERSARY\b', value): # If the value contains 'ANNIVERSARY', return the first word before 'ANNIVERSARY'
