 jython:import re
import re
def standardize_date(date):
  if len(date) == 8:
    return date[6] + '-' + date[0:2] + '-' + date[3:5]
  elif len(date) == 6:
    return date[0:4] + '-' + date[5:7] + '-' + date[8]
  else:
    match = re.match(r'(\d{2,4})-?(\d{1,2})-?(\d{1,2})', date)
    if match:
      return match.group(0) + '-' + match.group(1) + '-' + match.group(2)
    else:
      return None

