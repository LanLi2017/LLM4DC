INFO:root:#TASK III: generate regexr arguments: 

 jython:import re
def add_currency(value):
    if not value or 'dollars' in value.lower():
        return value
    elif re.search(r'\[.*\]$', value):
        value = value[:-2]
    return "%s" % ({value} dollars)

data['sponsor'] = data['sponsor'].apply(add_currency)
