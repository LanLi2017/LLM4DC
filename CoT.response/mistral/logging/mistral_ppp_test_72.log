INFO:root:#TASK III: generate regexr arguments: 

 jython:import re
from collections import Counter
data = """Gender
Unanswered,Unanswered,Female Owned,Unanswered,Unanswered,Unanswered,Male Owned,Unanswered,Unanswered,Male Owned;
Unanswered,Unanswered,Female Owned,Unanswered,Unanswered,Unanswered,Male Owned,Unanswered,Unanswered,Male Owned;
Female,Male Owned,Female,Male Owned,Male Owned,Male Owned,Female Owned,Male Owned,Female,Male Owned;"""

rows = data.strip().split('\n')[1:]

loan_amounts = {}

for row in rows:

    gender = row.split(',')[0].strip()

    if not gender or 'Unanswered' in gender:
        continue

    loan_amount = re.search(r'\d+(\.\d{2})?', ', '.join(gender[1:]))

    if loan_amount:

        loan_amounts[gender] = loan_amount.group(0) if loan_amount else 0

loan_counts = Counter(loan_amounts)
sorted_loan_counts = sorted(loan_counts.items(), key=lambda x: -x[1])

print("%s" % (The gender type that received the most amount of PPP loans is {sorted_loan_counts[0][0]}, with a total of ${sorted_loan_counts[0][1]}.))
return value
