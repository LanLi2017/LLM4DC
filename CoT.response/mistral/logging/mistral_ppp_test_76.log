 jython:import requests, json
    import re

    # Make a request to an API that provides PPP loan data for cities (replace 'API_URL' with the actual URL)
    response = requests.get('API_URL')
    data = json.loads(response.text)

    # Filter the data to only include city names and their corresponding PPP loan amounts
    filtered_data = [item for item in data if 'city' in item and 'loan_amount' in item]

    # Initialize an empty dictionary to store the cities and their corresponding loan amounts
    city_loans = {}

    # Iterate through the filtered data and add each city-loan pair to the dictionary
    for item in filtered_data:
        city, loan_amount = item['city'], item['loan_amount']
        if re.search(r'\b\w+\b', city):  # Ensure that the city name is a valid word (i.e., it doesn't contain any non-word characters)
            city_loans[city] = loan_amount

    # Sort the dictionary by loan amounts in descending order and take the first item (the city with the lowest amount of PPP loans)
    sorted_cities = sorted(city_loans.items(), key=lambda x: x[1], reverse=True)[:1]

    # Return the city name and its corresponding loan amount
    return f"{sorted_cities[0][0]}: ${sorted_cities[0][1]}"
