INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

# Assuming there is a new column 'LoanAmount' with the corresponding PPP loan amounts for each city

def clean_city(value):
    # Remove extra spaces, underscores, and special characters
    value = re.sub(r'\s+', ' ', value)
    value = re.sub(r'_', '', value)
    value = re.sub(r'[^a-zA-Z ]', '', value)

    # Convert to lowercase and return the cleaned city name
    return value.lower()

# Apply the clean_city function on the City column and sort by LoanAmount in ascending order
sorted_cities = df[['City', 'LoanAmount']].apply(clean_city).sort_values('LoanAmount')

# Find the cities with the lowest amount of PPP loans
lowest_loan_cities = sorted_cities.loc[0:2, 'City'].tolist()  # Assuming we want to find the top 3 cities with the lowest loan amounts
lowest_loan_amounts = sorted_cities.iloc[0:2]['LoanAmount'].tolist()

print("Cities with the lowest amount of PPP loans: ", lowest_loan_cities)
print("Corresponding dollar amounts: ", lowest_loan_amounts)
return value
