INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

# Remove hyphens, periods, or any other inconsistencies from the Zip column
def clean_zip(value):
    return re.sub(r'[^\d]', '', value)

# Apply the clean_zip function to each cell in the Zip column
data['Zip'] = data['Zip'].apply(clean_zip)

# Sort the dataframe by the cleaned Zip values and select the top 5 rows
top_loans = data.sort_values('Zip', ascending=True).head(5)

# Extract the Zip codes and corresponding loan amounts from the top 5 rows
zip_codes = top_loans['Zip'].tolist()
loan_amounts = top_loans['Loan Amount'].tolist()

# Combine the Zip codes and loan amounts into a list of tuples
results = list(zip(zip_codes, loan_amounts))

# Print the results in a readable format
for zip_code, amount in results:
    print(f'Zip Code: {zip_code}, Loan Amount: ${amount}')
return value
