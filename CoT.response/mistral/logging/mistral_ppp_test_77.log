INFO:root:#TASK III: generate regexr arguments: 

 jython:import re

# Assuming the original data is in 'data' variable as a list of lists
# Each sublist represents a row, with columns separated by commas

# Extract Zip codes and Loan Amounts using regular expressions
pattern = re.compile(r'\b\d{5}(-\d{4})?\b')  # Matches US zip codes (with or without extensions)
loans_data = []
for row in data:
    match = pattern.findall(row[0])  # Find all matches of the pattern in the first column (Loan Amount)
    if match:
        loan_amount = float(match[-1].replace(',', ''))  # Convert the last matched string to a float and remove commas
        zip_code = row[1]  # Assuming the Zip code is in the second column
        loans_data.append([zip_code, loan_amount])

# Sort the data by loan amounts in descending order
sorted_loans_data = sorted(loans_data, key=lambda x: x[1], reverse=True)

# Print the top 5 Zip codes and their corresponding loan amounts
for i in range(min(len(sorted_loans_data), 5)):
    print(f'{sorted_loans_data[i][0]}: ${sorted_loans_data[i][1]:,.2f}')
return value
