# Assuming that there is a new column named 'Zip Code' in your dataframe
def extract_zip(value):
    match = re.search(r'\b\d{5}\b', value)  # search for exactly 5 digits
    if match:
        return match.group(0)  # return the matched zip code
    else:
        return None  # return None if no zip code is found

# Assuming that there is a new column named 'Loan Amount' in your dataframe
def identify_highest_loans():
    grouped = df.groupby(['City', 'Zip Code'])['Loan Amount'].sum()  # group by City and Zip Code, then sum the loan amounts
    max_loans = grouped.max()  # find the maximum loan amount
    highest_geography = grouped[max_loans].index[0]  # get the City and Zip Code with the highest loan amount
    return highest_geography
return value
