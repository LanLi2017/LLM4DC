INFO:root:#TASK III: generate regexr arguments: 

 python
import re
from datetime import datetime

def standardize_dish_names(data):
    for row in data:
        # Remove special characters, spaces, and underscores
        cleaned_name = re.sub(r'[\[\];\:\.\-\_\']+', '', row).strip()

        # Check if the year is present in the name
        if '_' in cleaned_name:
            year_index = cleaned_name.find('_')
            year = cleaned_name[year_index + 1: year_index + 6]
            try:
                year = int(year)
                if year < datetime.now().year and year >= 1900:
                    data[data.index(row)] = f"{cleaned_name[:year_index]}_{year}{cleaned_name[year_index + 6:]}"
            except ValueError:
                pass
        else:
            # If the year is not present, assume it's from before 2000
            if cleaned_name and len(cleaned_name) > 4:
                data[data.index(row)] = f"{cleaned_name}_1900"

    return data
return value
