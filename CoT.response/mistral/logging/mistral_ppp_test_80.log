 jython:import re

# Standardize inconsistent representations in the RaceEthnicity column
def standardize_race(value):
    value = value.lower()  # Convert to lowercase for easier comparison

    if "hisp" in value:
        return "Hispanic"
    elif "latino" in value:
        return "Hispanic"
    elif "black" in value or "african" in value:
        return "Black African American"
    elif "native" in value and "hawaiian" in value:
        return "Native Hawaiian"
    elif "asian" in value:
        return "Asian"
    elif "white" in value:
        return "White"
    else:
        return "Other"

# Assuming you have a DataFrame df with the RaceEthnicity column and a column for PPP loan amounts (e.g., LoanAmount)
df['RaceEthnicity'] = df['RaceEthnicity'].apply(standardize_race)

# Now group by the standardized RaceEthnicity and sum the corresponding loan amounts
top_races = df.groupby('RaceEthnicity')['LoanAmount'].sum().sort_values(ascending=False)
return value
