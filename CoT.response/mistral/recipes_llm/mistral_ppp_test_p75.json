        "expression": "jython:import re\n\n# Standardize and clean the Gender column by correcting inconsistent spelling and formatting\ngender_pattern = re.compile(r'[^mfF\\s]')  # Matches any character that is not 'm', 'f', or whitespace\ngender_correction = {\n    'MALE OWNED': 'male owned',\n    'Mle': 'male',\n    'femal': 'female',\n    'mlae': 'male',\n    'nn-binary': 'non-binary',\n    'Feale': 'female'\n}\n\ndef clean_gender(value):\n    value = gender_pattern.sub('', value).lower()  # Remove non-alphabetic characters and convert to lowercase\n    return gender_correction.get(value, value)  # If the cleaned value is in the correction dictionary, use that\notherwise, keep the original value\n\n# Apply clean_gender function to the Gender column\ncleaned_genders = [clean_gender(cell) for cell in genders]\nreturn value",
