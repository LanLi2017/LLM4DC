def evaluate_column_quality(column_name, data, purpose):
    # Profiling the column
    print(f"Profiling {column_name}...")
    
    # Assessing accuracy
    if any(not isinstance(value, str) for value in data):
        print(f"{column_name}: Accuracy - False (data type not consistent)")
        return False
    
    # Assessing relevance
    if purpose not in column_name:
        print(f"{column_name}: Relevance - False")
        return False
    
    # Assessing completeness
    if len(data) == 0 or len(set(data)) < len(data):
        print(f"{column_name}: Completeness - False (missing values)")
        return False
    
    # Assessing conciseness
    if not all(value.lower() == value for value in data):
        print(f"{column_name}: Conciseness - False")
        return False
    
    # If all assessments are True, return True
    print(f"{column_name}: All quality dimensions are True.")
    return True

