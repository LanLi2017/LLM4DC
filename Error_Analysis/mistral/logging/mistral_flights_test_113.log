  ```jython:from datetime import datetime\nimport re\npattern = re.compile(r'[Tt]\s*(\d{4})-(\d{2})-(\d{2})\s+(\d{2}):(\d{2}):(\d{2})(?:Z|([+-])\d{2}:?\d{2})?')\ndef standardize_time(match):\n    time, offset = match.groups()\n    if not time or not offset:\n        return datetime.strptime(time, '%Y-%m-%d %H:%M:%S').isoformat() + 'Z'\n    else:\n        hours, minutes = map(int, offset.split(':'))\n        offset_minutes = hours * 60 + minutes\n        dt = datetime.strptime(time, '%Y-%m-%d %H:%M:%S') + datetime.timedelta(minutes=offset_minutes)\n        return dt.isoformat() + 'Z'\nreturn pattern.sub(standardize_time, value)```

