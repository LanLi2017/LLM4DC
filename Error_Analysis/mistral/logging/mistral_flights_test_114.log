# Define a pattern for airline names (case insensitive)
pattern = r'(a[ir]|allegiantair|americanairlines|deltaairlines|easyjet|flybe|frontierairlines|helleflight|jetblueairways|lufthansa|southwestairlines|spiritairlines|unitedairlines|virginamerica|virginaustralia|westjet)'

