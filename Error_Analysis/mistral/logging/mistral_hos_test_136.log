 # Standardize the representation of voluntary non-profits across all rows in the HospitalOwner column
 def standardize_hospital_owner(value):
     if re.search(r'VOLUNTARY', value, re.IGNORECASE):
         return 'Voluntary Non-Profit'
     elif re.search(r'GOVERNMENT', value, re.IGNORECASE) and (re.search(r'\bHOSPITAL\b', value) or re.search(r'\bDISTRICT\b', value) or re.search(r'\bAUTHORITY\b', value)):
         return 'Government - Hospital'
     elif re.search(r'GOVERNMENT', value, re.IGNORECASE) and (re.search(r'\bLOCAL\b', value) or re.search(r'\bFEDERAL\b', value)):
         return 'Government - Local'
     elif re.search(r'PROPRIETARY', value, re.IGNORECASE):
         return 'Proprietary'
     elif re.search(r'VOLUNTARY NON-PROFIT', value, re.IGNORECASE) or re.search(r'VOLUNTARY_NON-PROFIT', value, re.IGNORECASE) or re.search(r'VOLUNTARY\_NON-PROFIT', value, re.IGNORECASE):
         return 'Voluntary Non-Profit'
     elif re.search(r'VOLUNTARY NON-PROFIT - PRIVATE', value, re.IGNORECASE) or re.search(r'VOLUNTARY\_NON-PROFIT\_\_-_PRIVATE', value, re.IGNORECASE):
         return 'Voluntary Non-Profit - Private'
     elif re.search(r'VOLUNTARY NON-PROFIT - OTHER', value, re.IGNORECASE) or re.search(r'VOLUNTARY\_NON-PROFIT\_\_-_OTHER', value, re.IGNORECASE):
         return 'Voluntary Non-Profit - Other'
     else:
         return 'Unknown'

 # Find the number of cities with hospitals owned by voluntary non-profits and offering emergency services
 def find_emergency_hospitals(data):
     emergency_hospitals = 0
