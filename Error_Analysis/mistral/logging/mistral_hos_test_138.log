  ```jython:import re

def regexr_transform(column):
    if column == 'HospitalOwner':
        return_list = []
        for value in column:
            # Remove spaces, hyphens, underscores and convert to uppercase
            cleaned_value = re.sub(r'[\s-_]', '', value.upper())

            if cleaned_value == 'GOVERNMENT':
                return_list.append('Government')
            elif cleaned_value in ['VOLUNTARY_NON-PROFIT', 'VOLUNTARY NON-PROFIT']:
                return_list.append('Voluntary Non-Profit')
            elif cleaned_value == 'PROPQIETARY' or cleaned_value == 'PROPRAETARY' or cleaned_value == 'PRIVATP':
                return_list.append('Proprietary')
            else:
                return_list.append(cleaned_value)
        return return_list
```

