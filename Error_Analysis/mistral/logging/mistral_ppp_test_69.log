def clean_business_type(value):
  value = value.lower() # Standardize capitalization
  value = re.sub(r'\bllc\b', 'Limited Liability Company', value) # Abbreviations to full names
  value = re.sub(r'\bcorp\b', 'Corporation', value)
  value = re.sub(r'\bsole proprietorship\b', 'Sole Proprietorship', value)
  value = re.sub(r'\bsubchapter s corporation\b', 'Subchapter S Corporation', value)
  return value

# Apply the function to each row in the BusinessType column
data['BusinessType'] = data['BusinessType'].apply(clean_business_type)
```

