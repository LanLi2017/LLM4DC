# Define a function to standardize race names
def standardize_race(name):
    # Remove any non-alphabetic characters
    name = re.sub(r'\W+', '', name)

    # Convert to lowercase and remove extra spaces
    name = name.lower().replace(' ', '')

    # Standardize some common variations of race names
    if 'hispaic' in name:
        return 'Hispanic'
    elif 'ntv' in name:
        return 'Native Hawaiian'
    elif 'as1an' in name or 'Aisan' in name:
        return 'Asian'
    elif 'whiite' in name or 'wh1te' in name:
        return 'White'
    elif 'b.a.a.' in name:
        return 'Black/African American'
    else:
        return name

