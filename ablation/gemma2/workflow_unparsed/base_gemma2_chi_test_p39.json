  },
  {
    "columnName": "Results",
    "op": "mass_edit",
    "args": "[{\"from\": [\"Pass\"], \"to\": \"Pass\"}, {\"from\": [\"Fail\"], \"to\": \"Fail\"}, {\"from\": [\"Out of Business\"], \"to\": \"Out of Business\"}]"
  }
