import re
from collections import Set

data = [
    # ... your data here ...
]

occasions = Set()
for row in data:
    date_str = row[-1] if len(row) > 7 and row[-1] != 'nan' else None
    if date_str:
        occasions.add(date_str)

unique_occasions = len(occasions)
print(f"Total number of unique occasions: {unique_occasions}")