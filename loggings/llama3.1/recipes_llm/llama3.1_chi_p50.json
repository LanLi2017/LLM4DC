[
    {
        "op": "core/text-transform",
        "engineConfig": {
            "facets": [],
            "mode": "row-based"
        },
        "columnName": "Inspection ID",
        "expression": "value.toUppercase()",
        "onError": "set-to-blank",
        "repeat": false,
        "repeatCount": 10,
        "description": "Text transform on cells in column Inspection ID using expression value.toUppercase()"
    },
    {
        "op": "core/mass-edit",
        "engineConfig": {
            "facets": [],
            "mode": "row-based"
        },
        "columnName": "Inspection Type",
        "expression": "value",
        "edits": [
            {
                "from": [
                    "license re-inspection",
                    "license_re-inspection"
                ],
                "fromBlank": false,
                "fromError": false,
                "to": "License Re-Inspection"
            },
            {
                "from": [
                    "complaiint",
                    "complaint re-inspection"
                ],
                "fromBlank": false,
                "fromError": false,
                "to": "Complaint"
            }
        ],
        "description": "Mass edit cells in column Inspection Type"
    }
]